#!/usr/bin/env python3
"""OPENHTPC Basic end-user command."""
import importlib.util
import json
import os
import pathlib
import subprocess
import sys

home = pathlib.Path(os.environ.get("OPENHTPC_HOME", pathlib.Path.home()))
install = pathlib.Path(os.environ.get("OPENHTPC_INSTALL_DIR", home / ".local/lib/openhtpc"))
spec = importlib.util.spec_from_file_location("openhtpc_core", install / "openhtpc-core.py")
core = importlib.util.module_from_spec(spec)
spec.loader.exec_module(core)

command = sys.argv[1:] or ["start"]
if command in (["doctor"],["doctor","--json"]):
    if command[-1]=="--json":
        report=core.health_report(home,install);print(json.dumps(report,ensure_ascii=False,indent=2));raise SystemExit(1 if report["overall"]=="BLOCKED" else 0)
    status, lines = core.doctor(home, install)
    print("\n".join(lines))
    raise SystemExit(1 if status == "BLOCKED" else 0)
if command == ["plugins"]:
    plugins, errors = core.installed_plugins(home, install)
    print(json.dumps({"plugins": plugins, "errors": errors}, ensure_ascii=False, indent=2))
    raise SystemExit(1 if errors else 0)
if command == ["version"]:
    print((install / "VERSION").read_text().strip())
    raise SystemExit(0)
if command and command[0] == "capabilities":
    allowed = {("capabilities",), ("capabilities", "--json"), ("capabilities", "--refresh"), ("capabilities", "--refresh", "--json"), ("capabilities", "--json", "--refresh")}
    if tuple(command) not in allowed:
        print("Usage: openhtpc capabilities [--json] [--refresh]", file=sys.stderr); raise SystemExit(2)
    os.execv(install / "openhtpc-capabilities.py", [str(install / "openhtpc-capabilities.py"), *command[1:]])
if command and command[0] in ("read-ahead", "readahead"):
    os.execv(install / "openhtpc-readahead.py", [str(install / "openhtpc-readahead.py"), *command[1:]])
if command and command[0] in ("video-benchmark", "benchmark"):
    os.execv(install / "openhtpc-benchmark.py", [str(install / "openhtpc-benchmark.py"), *command[1:]])
if command and command[0] in ("recipe-benchmark", "recipes"):
    os.execv(install / "openhtpc-recipes.py", [str(install / "openhtpc-recipes.py"), *command[1:]])
if command and command[0] in ("visual-review", "review"):
    os.execv(install / "openhtpc-visual-review.py", [str(install / "openhtpc-visual-review.py"), *command[1:]])
if command and command[0] == "calibrate":
    os.execv(install / "openhtpc-calibrate.py", [str(install / "openhtpc-calibrate.py"), *command[1:]])
if command and command[0] == "cinema-auto":
    os.execv(install / "openhtpc-cinema-auto.py", [str(install / "openhtpc-cinema-auto.py"), *command[1:]])
if command and command[0] == "video-profile":
    os.execv(install / "openhtpc-video-profile.py", [str(install / "openhtpc-video-profile.py"), *command[1:]])
if command == ["support-bundle"]:
    os.execv(install/"openhtpc-support-bundle.py",[str(install/"openhtpc-support-bundle.py")])
if command == ["setup"]:
    os.execv(install / "openhtpc-initial-setup.py", [str(install / "openhtpc-initial-setup.py"), "--home", str(home)])
if command == ["start"]:
    subprocess.Popen([str(install / "openhtpc-session-start")], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    raise SystemExit(0)
if command == ["stop"]:
    os.execv(install / "openhtpc-quit", [str(install / "openhtpc-quit")])
print("Usage: openhtpc [start|stop|setup|doctor|plugins|version|capabilities|read-ahead|video-benchmark|recipe-benchmark|visual-review|calibrate|cinema-auto|video-profile|support-bundle]", file=sys.stderr)



raise SystemExit(2)
