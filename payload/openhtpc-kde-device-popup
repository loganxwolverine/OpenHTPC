#!/usr/bin/env python3
"""Reversibly suppress Plasma 6 Device Notifier optical auto-popup."""
import configparser,json,os,pathlib,shutil,subprocess,sys,tempfile

home=pathlib.Path(os.environ.get("OPENHTPC_HOME",pathlib.Path.home()))
state=home/".local/state/openhtpc/kde-device-popup.json"; state.parent.mkdir(parents=True,exist_ok=True)
layout=home/".config/plasma-org.kde.plasma.desktop-appletsrc"
kread=shutil.which("kreadconfig6"); kwrite=shutil.which("kwriteconfig6"); gdbus=shutil.which("gdbus")

def notifier_groups():
 parser=configparser.RawConfigParser(strict=False); parser.optionxform=str
 try: parser.read(layout,encoding="utf-8")
 except OSError: return []
 result=[]
 for section in parser.sections():
  if parser.get(section,"plugin",fallback="")=="org.kde.plasma.devicenotifier":
   result.append(section.strip("[]").split("][")+["Configuration","General"])
 return result

def group_args(group):
 return [item for name in group for item in ("--group",name)]

def read(group):
 if not kread: return None
 p=subprocess.run([kread,"--file",str(layout),*group_args(group),"--key","popupOnNewDevice","--default","true"],text=True,capture_output=True,timeout=5)
 return p.stdout.strip().lower() if p.returncode==0 else None

def write(group,value):
 if not kwrite: return False
 p=subprocess.run([kwrite,"--file",str(layout),*group_args(group),"--key","popupOnNewDevice",value],timeout=5)
 return p.returncode==0 and read(group)==value

def refresh():
 if not gdbus: return False
 p=subprocess.run([gdbus,"call","--session","--dest","org.kde.plasmashell","--object-path","/PlasmaShell","--method","org.kde.PlasmaShell.refreshCurrentShell"],capture_output=True,timeout=8)
 return p.returncode==0

def save(value):
 fd,tmp=tempfile.mkstemp(prefix="kde-popup.",dir=state.parent)
 with os.fdopen(fd,"w") as stream: json.dump(value,stream,sort_keys=True); stream.write("\n")
 os.chmod(tmp,0o600); os.replace(tmp,state)

if len(sys.argv)==2 and sys.argv[1]=="enter":
 groups=notifier_groups(); previous=[]
 try: saved=json.loads(state.read_text()); previous=saved.get("previous",[]) if saved.get("applied") else []
 except (OSError,json.JSONDecodeError): previous=[]
 if not previous:
  for group in groups:
   old=read(group)
   if old in {"true","false"}: previous.append({"group":group,"old":old})
 applied=bool(previous) and all(write(item["group"],"false") for item in previous)
 refreshed=refresh() if applied else False
 save({"schema":2,"component":"org.kde.plasma.devicenotifier","key":"popupOnNewDevice","previous":previous,"applied":applied,"refreshed":refreshed})
 raise SystemExit(0 if applied and refreshed else 4)
if len(sys.argv)==2 and sys.argv[1]=="leave":
 try: previous=json.loads(state.read_text()).get("previous",[])
 except (OSError,json.JSONDecodeError): previous=[]
 restored=all(write(item["group"],item["old"]) for item in previous if isinstance(item,dict) and item.get("old") in {"true","false"})
 if previous: refresh()
 try: state.unlink()
 except FileNotFoundError: pass
 raise SystemExit(0 if restored or not previous else 4)
raise SystemExit(2)
