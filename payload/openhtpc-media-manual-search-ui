def get_prefill_hints(
    db: sqlite3.Connection,
    media_version_id: int,
) -> tuple[str, str]:
    """Determine initial title and year prefill clues without contacting provider."""
    cur = db.execute(
        "SELECT work_id, provisional_title, provisional_year, identification_state "
        "FROM media_versions WHERE id = ?",
        (media_version_id,),
    )
    row = cur.fetchone()
    if not row:
        return "", ""

    work_id, prov_title, prov_year, _ = row

    title = ""
    year = ""

    if work_id:
        w_cur = db.execute("SELECT title, year FROM works WHERE id = ?", (work_id,))
        w_row = w_cur.fetchone()
        if w_row:
            if w_row[0]:
                title = str(w_row[0])
            if w_row[1]:
                year = str(w_row[1])

    if not title and prov_title:
        title = str(prov_title)

    if not year and prov_year:
        year = str(prov_year)

    if not title:
        r_cur = db.execute(
            "SELECT relative_path, canonical_path FROM resources WHERE media_version_id = ? LIMIT 1",
            (media_version_id,),
        )
        r_row = r_cur.fetchone()
        if r_row:
            p_str = r_row[0] or r_row[1] or ""
            if p_str:
                title = Path(p_str).stem

    return title, year


def invoke_text_entry(
    title: str,
    initial: str = "",
    max_length: int = 255,
    submit_label: str = "VALIDER",
    cancel_label: str = "ANNULER",
    install: Path | None = None,
    env: dict[str, str] | None = None,
    platform_arg: str | None = None,
) -> dict[str, Any]:
    """Invoke openhtpc-text-entry.py via subprocess with clean argument passing."""
    candidates = [
        install / "openhtpc-text-entry.py" if install else None,
        Path(__file__).resolve().parent / "openhtpc-text-entry.py",
    ]
    script_path: Path | None = None
    for p in candidates:
        if p and p.is_file():
            script_path = p
            break

    if not script_path:
        raise FileNotFoundError("openhtpc-text-entry.py component not found")

    cmd = [
        sys.executable,
        str(script_path),
        "--title",
        str(title),
        "--initial-text",
        str(initial),
        "--max-length",
        str(max_length),
        "--submit-label",
        str(submit_label),
        "--cancel-label",
        str(cancel_label),
    ]

    effective_env = dict(os.environ if env is None else env)
    if platform_arg:
        cmd.extend(["-platform", platform_arg])
    elif effective_env.get("QT_QPA_PLATFORM"):
        cmd.extend(["-platform", effective_env["QT_QPA_PLATFORM"]])

    proc = subprocess.run(
        cmd,
        env=effective_env,
        capture_output=True,
        text=True,
        timeout=300,
    )

    if proc.returncode != 0:
        return {"ok": False, "cancelled": True, "text": initial}

    stdout_clean = proc.stdout.strip()
    if not stdout_clean:
        return {"ok": False, "cancelled": True, "text": initial}

    try:
        data = json.loads(stdout_clean)
        if isinstance(data, dict):
            return data
    except json.JSONDecodeError:
        # If there's extra text, try finding the last JSON block
        matches = re.findall(r"\{[^{}]*\}", stdout_clean, re.DOTALL)
        if matches:
            try:
                data = json.loads(matches[-1])
                if isinstance(data, dict):
                    return data
            except json.JSONDecodeError:
                pass

    return {"ok": False, "cancelled": True, "text": initial}


def create_confirmation_window_class():
    from PySide6 import QtCore, QtGui, QtWidgets

    class ConfirmationWindow(QtWidgets.QWidget):
        def __init__(self, title: str, year: str) -> None:
            super().__init__()
            self.title_text = title
            self.year_text = year
            self.decision = "CANCEL"

            self.setWindowTitle("OPENHTPC — Confirmation de recherche")
            self.setStyleSheet("""
                QWidget {
                    background-color: #161b22;
                    color: #c9d1d9;
                    font-family: 'Open Sans', 'Noto Sans', sans-serif;
                }
                QLabel#HeaderLabel {
                    color: #58a6ff;
                    font-size: 26px;
                    font-weight: bold;
                    padding-bottom: 10px;
                }
                QFrame#InfoBox {
                    background-color: #0d1117;
                    border: 2px solid #30363d;
                    border-radius: 8px;
                    padding: 24px;
                }
                QLabel#MovieTitle {
                    color: #ffffff;
                    font-size: 30px;
                    font-weight: bold;
                }
                QLabel#MovieYear {
                    color: #8b949e;
                    font-size: 22px;
                    font-weight: 500;
                }
                QPushButton.ActionBtn {
                    background-color: #21262d;
                    border: 2px solid #30363d;
                    border-radius: 8px;
                    color: #c9d1d9;
                    font-size: 20px;
                    font-weight: bold;
                    min-height: 52px;
                    min-width: 170px;
                    padding: 8px 16px;
                }
                QPushButton.ActionBtnSelected {
                    background-color: #238636;
                    border: 3px solid #56d364;
                    border-radius: 8px;
                    color: #ffffff;
                    font-size: 21px;
                    font-weight: bold;
                    min-height: 52px;
                    min-width: 170px;
                    padding: 8px 16px;
                }
                QLabel#HelpLabel {
                    color: #6e7681;
                    font-size: 15px;
                    padding-top: 10px;
                }
            """)

            main_layout = QtWidgets.QVBoxLayout(self)
            main_layout.setContentsMargins(60, 40, 60, 40)
            main_layout.setSpacing(20)

            header = QtWidgets.QLabel("RECHERCHER CE FILM SUR TMDB ?")
            header.setObjectName("HeaderLabel")
            header.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
            main_layout.addWidget(header)

            info_box = QtWidgets.QFrame()
            info_box.setObjectName("InfoBox")
            box_layout = QtWidgets.QVBoxLayout(info_box)
            box_layout.setSpacing(8)

            t_lbl = QtWidgets.QLabel(self.title_text)
            t_lbl.setObjectName("MovieTitle")
            t_lbl.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
            t_lbl.setWordWrap(True)
            box_layout.addWidget(t_lbl)

            y_str = f"Année : {self.year_text}" if self.year_text else "Année : non spécifiée"
            y_lbl = QtWidgets.QLabel(y_str)
            y_lbl.setObjectName("MovieYear")
            y_lbl.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
            box_layout.addWidget(y_lbl)

            main_layout.addWidget(info_box)

            self.buttons: list[QtWidgets.QPushButton] = []
            btn_labels = ["RECHERCHER", "MODIFIER", "ANNULER"]
            self.selected_idx = 0

            btn_layout = QtWidgets.QHBoxLayout()
            btn_layout.setSpacing(20)

            for bl in btn_labels:
                btn = QtWidgets.QPushButton(bl)
                btn.setProperty("class", "ActionBtn")
                btn.setFocusPolicy(QtCore.Qt.FocusPolicy.NoFocus)
                btn_layout.addWidget(btn)
                self.buttons.append(btn)

            main_layout.addLayout(btn_layout)

            help_lbl = QtWidgets.QLabel("Flèches : Choisir  •  Entrée : Valider  •  Échap : Annuler")
            help_lbl.setObjectName("HelpLabel")
            help_lbl.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
            main_layout.addWidget(help_lbl)

            self.update_btn_states()

        def update_btn_states(self) -> None:
            for i, btn in enumerate(self.buttons):
                is_sel = (i == self.selected_idx)
                btn.setProperty("class", "ActionBtnSelected" if is_sel else "ActionBtn")
                btn.style().unpolish(btn)
                btn.style().polish(btn)

        def keyPressEvent(self, event: QtGui.QKeyEvent) -> None:
            key = event.key()
            if key in (QtCore.Qt.Key.Key_Left, QtCore.Qt.Key.Key_Up):
                self.selected_idx = (self.selected_idx - 1) % len(self.buttons)
                self.update_btn_states()
                event.accept()
            elif key in (QtCore.Qt.Key.Key_Right, QtCore.Qt.Key.Key_Down):
                self.selected_idx = (self.selected_idx + 1) % len(self.buttons)
                self.update_btn_states()
                event.accept()
            elif key in (QtCore.Qt.Key.Key_Return, QtCore.Qt.Key.Key_Enter):
                if self.selected_idx == 0:
                    self.decision = "SEARCH"
                elif self.selected_idx == 1:
                    self.decision = "MODIFY"
                else:
                    self.decision = "CANCEL"
                self.close()
                event.accept()
            elif key in (QtCore.Qt.Key.Key_Escape, QtCore.Qt.Key.Key_Back):
                self.decision = "CANCEL"
                self.close()
                event.accept()
            else:
                super().keyPressEvent(event)

    return ConfirmationWindow


