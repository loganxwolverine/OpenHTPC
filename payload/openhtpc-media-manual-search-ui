def show_confirmation_window(
    title: str,
    year: str,
    env: dict[str, str] | None = None,
    install: Path | None = None,
    platform_arg: str | None = None,
) -> str:
    """Display explicit search confirmation window and return 'SEARCH', 'MODIFY', or 'CANCEL'."""
    from PySide6 import QtGui, QtWidgets

    app = QtWidgets.QApplication.instance()
    created_app = False
    if app is None:
        qt_args = [sys.argv[0]]
        if platform_arg:
            qt_args.extend(["-platform", platform_arg])
        elif env and env.get("QT_QPA_PLATFORM"):
            qt_args.extend(["-platform", env["QT_QPA_PLATFORM"]])
        app = QtWidgets.QApplication(qt_args)
        created_app = True

    # Font setup
    font_candidates = [
        (install / "flex/assets/fonts/OpenSans-Regular.ttf") if install else None,
        Path(os.environ.get("OPENHTPC_INSTALL_DIR", Path.home() / ".local/lib/openhtpc")) / "flex/assets/fonts/OpenSans-Regular.ttf",
        Path(__file__).resolve().parent / "flex/assets/fonts/OpenSans-Regular.ttf",
    ]
    for fc in font_candidates:
        if fc and fc.is_file():
            fid = QtGui.QFontDatabase.addApplicationFont(str(fc))
            families = QtGui.QFontDatabase.applicationFontFamilies(fid)
            if families:
                app.setFont(QtGui.QFont(families[0], 14))
                break

    win_cls = create_confirmation_window_class()
    window = win_cls(title, year)
    window.resize(800, 480)
    window.show()

    if created_app:
        app.exec()
    return window.decision


