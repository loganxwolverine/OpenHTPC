def orchestrate_manual_search(
    media_version_id: int,
    home: Path | None = None,
    install: Path | None = None,
    platform_arg: str | None = None,
    custom_db_path: Path | None = None,
    mock_search_fn: Any | None = None,
) -> int:
    """Main orchestration flow for living-room manual search."""
    if home is None:
        home = Path(os.environ.get("OPENHTPC_HOME", Path.home()))
    if install is None:
        install = Path(os.environ.get("OPENHTPC_INSTALL_DIR", home / ".local/lib/openhtpc"))

    db_path = custom_db_path or (home / ".local/share/openhtpc/media/media.db")
    if not db_path.is_file():
        print(f"ERROR: Database not found at {db_path}", file=sys.stderr)
        return 1

    # Step 1: Read prefill hints from database (Read-only)
    try:
        with sqlite3.connect(f"file:{db_path}?mode=ro", uri=True) as ro_db:
            initial_title, initial_year = get_prefill_hints(ro_db, media_version_id)
    except sqlite3.Error as exc:
        print(f"ERROR: Failed reading database: {exc}", file=sys.stderr)
        return 1

    env = resolve_graphical_env(install)

    # Step 2: Loop title -> year -> confirmation
    current_title = initial_title
    current_year = initial_year

    while True:
        # Title Entry
        t_res = invoke_text_entry(
            title="OPENHTPC — Titre du film",
            initial=current_title,
            max_length=255,
            submit_label="SUIVANT",
            install=install,
            env=env,
            platform_arg=platform_arg,
        )
        if t_res.get("cancelled") or not t_res.get("ok"):
            return 0
        entered_title = t_res.get("text", "").strip()
        if not entered_title:
            return 0
        current_title = entered_title

        # Year Entry
        y_res = invoke_text_entry(
            title="OPENHTPC — Année (optionnelle)",
            initial=current_year,
            max_length=4,
            submit_label="VALIDER",
            install=install,
            env=env,
            platform_arg=platform_arg,
        )
        if y_res.get("cancelled") or not y_res.get("ok"):
            return 0
        current_year = y_res.get("text", "").strip()

        # Confirmation Dialog
        decision = show_confirmation_window(
            title=current_title,
            year=current_year,
            env=env,
            install=install,
            platform_arg=platform_arg,
        )

        if decision == "CANCEL":
            return 0
        elif decision == "MODIFY":
            continue
        elif decision == "SEARCH":
            break

    # Step 3: Network authority gate — exactly ONE call to DEV5C3A manual search
    clean_year_val: int | None = None
    if current_year:
        try:
            clean_year_val = int(current_year)
        except ValueError:
            clean_year_val = None

    try:
        with sqlite3.connect(str(db_path), timeout=10.0) as rw_db:
            rw_db.execute("PRAGMA foreign_keys = ON;")
            rw_db.execute("PRAGMA busy_timeout = 5000;")

            if mock_search_fn is not None:
                res = mock_search_fn(
                    db=rw_db,
                    media_version_id=media_version_id,
                    title=current_title,
                    year=clean_year_val,
                    home=home,
                )
            else:
                match_mod = _load_media_match(install)
                if not match_mod:
                    print("ERROR: openhtpc-media-match module unavailable", file=sys.stderr)
                    return 1
                res = match_mod.manual_search_media_version(
                    db=rw_db,
                    media_version_id=media_version_id,
                    title=current_title,
                    year=clean_year_val,
                    home=home,
                )
    except sqlite3.Error as exc:
        print(f"ERROR: Database transaction failed: {exc}", file=sys.stderr)
        return 1

    # Step 4: Handle result
    if not res.get("ok"):
        # Provider failure: zero database mutation, display living-room error screen
        show_error_window(
            message="Vérifiez la connexion réseau ou la configuration TMDb.",
            env=env,
            install=install,
            platform_arg=platform_arg,
        )
        return 0

    # Step 5: Success (either candidates stored or OK_NO_RESULTS) -> regenerate Flex UI
    match_ui = _load_media_match_ui(install)
    if match_ui and hasattr(match_ui, "_regenerate_ui"):
        match_ui._regenerate_ui(home, install)

    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="OpenHTPC Living-Room Media Manual Search Orchestrator")
    parser.add_argument("action_or_id", nargs="?", default=None, help="Action ('search') or media_version_id")
    parser.add_argument("media_version_id", nargs="?", type=int, default=None, help="Target media_version_id")
    parser.add_argument("--home", type=Path, default=None, help="OpenHTPC home directory")
    parser.add_argument("--install-dir", type=Path, default=None, help="OpenHTPC install directory")
    parser.add_argument("-platform", default=None, help="Qt platform (e.g. offscreen, wayland)")

    raw_args = list(sys.argv[1:] if argv is None else argv)
    platform_val = None
    if "-platform" in raw_args:
        idx = raw_args.index("-platform")
        if idx + 1 < len(raw_args):
            platform_val = raw_args[idx + 1]
            del raw_args[idx:idx + 2]
        else:
            del raw_args[idx]

    try:
        args = parser.parse_args(raw_args)
    except SystemExit as exc:
        return exc.code

    mv_id: int | None = None
    if args.action_or_id:
        if args.action_or_id.isdigit():
            mv_id = int(args.action_or_id)
        elif args.action_or_id == "search" and args.media_version_id is not None:
            mv_id = args.media_version_id

    if mv_id is None:
        print("ERROR: media_version_id is required", file=sys.stderr)
        return 2

    return orchestrate_manual_search(
        media_version_id=mv_id,
        home=args.home,
        install=args.install_dir,
        platform_arg=platform_val,
    )


if __name__ == "__main__":
    sys.exit(main())
