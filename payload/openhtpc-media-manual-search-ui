#!/usr/bin/env python3
"""OpenHTPC Living-Room Media Manual Search Orchestrator (DEV5C3B2).

Coordinates the couch search flow:
1. Prefills title and year from local database clues.
2. Invokes generic text entry for movie title.
3. Invokes generic text entry for optional year.
4. Displays living-room confirmation screen.
5. On confirmation: executes DEV5C3A manual search (exactly ONE provider call).
6. Regenerates canonical Flex resolver menus on success.
7. Displays living-room error screen on provider failure without modifying database.

Zero network calls before explicit final confirmation.
Zero database schema changes.
Single-Flex architecture with safe :applyback return.
"""
from __future__ import annotations

import argparse
import importlib.util
import json
import os
from pathlib import Path
import re
import sqlite3
import subprocess
import sys
from typing import Any

DEFAULT_LANGUAGE = "fr-FR"


def resolve_graphical_env(install: Path | None = None) -> dict[str, str]:
    """Authoritatively resolve the active graphical session environment."""
    env = dict(os.environ)
    if env.get("WAYLAND_DISPLAY") and env.get("XDG_RUNTIME_DIR"):
        return env
    try:
        candidates = [
            install / "openhtpc-capabilities.py" if install else None,
            Path(__file__).resolve().parent / "openhtpc-capabilities.py",
        ]
        for p in candidates:
            if p and p.is_file():
                spec = importlib.util.spec_from_file_location("openhtpc_capabilities", p)
                if spec and spec.loader:
                    caps = importlib.util.module_from_spec(spec)
                    spec.loader.exec_module(caps)
                    ctx = caps.resolve_graphical_context()
                    if ctx.get("status") == "RESOLVED" and ctx.get("environment"):
                        env.update(ctx["environment"])
                        return env
    except Exception:
        pass
    return env


