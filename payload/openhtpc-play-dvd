#!/usr/bin/env bash
set -u
readonly HOME_DIR="${OPENHTPC_HOME:-$HOME}"
readonly INSTALL="${OPENHTPC_INSTALL_DIR:-$HOME_DIR/.local/lib/openhtpc}"
readonly PROFILE="$HOME_DIR/.config/openhtpc/profile.json"
readonly OPTICAL_STATE="$HOME_DIR/.local/state/openhtpc/optical-current.json"
fail_and_return_ui(){
    local reason="${1:-DISPATCH_REFUSED}"
    python3 -c '
import importlib.util,pathlib,sys
try:
    spec=importlib.util.spec_from_file_location("p",sys.argv[1]);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
    disp_id = sys.argv[4] if len(sys.argv)>4 and sys.argv[4] else None
    if not disp_id and hasattr(m, "record_playback_dispatch"):
        rec = m.record_playback_dispatch(pathlib.Path(sys.argv[2]), {}, kind="dvd")
        if isinstance(rec, dict):
            disp_id = rec.get("dispatch_id")
    if disp_id and hasattr(m, "record_playback_failure"):
        m.record_playback_failure(pathlib.Path(sys.argv[2]), reason=sys.argv[3], kind="dvd", dispatch_id=disp_id)
except Exception:pass
' "$INSTALL/openhtpc-playback-policy.py" "$HOME_DIR" "$reason" "${dispatch_id:-}" 2>/dev/null || true
    return_ui
}
return_ui(){ [[ ${OPENHTPC_FLEX_RETAINED:-0} == 1 ]] && exit 0; exec "$INSTALL/openhtpc-dvd-ui"; }
[[ $# -eq 1 && $1 == /dev/* ]] || fail_and_return_ui "DVD_ARGUMENT_INVALID"
device=$1
state="$(cat "$OPTICAL_STATE" 2>/dev/null)" || fail_and_return_ui "DVD_STATE_UNAVAILABLE"
python3 - "$device" "$state" <<'PY'
import json,sys
s=json.loads(sys.argv[2]); raise SystemExit(0 if s.get("state")=="DVD" and s.get("device")==sys.argv[1] else 1)
PY
[[ $? -eq 0 ]] || fail_and_return_ui "DVD_STATE_INVALID"
runtime="$(python3 - "$PROFILE" <<'PY'
import json,pathlib,sys
try:
 p=json.loads(pathlib.Path(sys.argv[1]).read_text()); x=p["runtime_profiles"]["profiles"]["PURE"]; c=pathlib.Path(x["config_path"])
 if p["runtime"]["status"]!="ready" or x["generation_status"]!="generated" or not c.is_file(): raise ValueError
 print(c)
except Exception: raise SystemExit(1)
PY
)" || fail_and_return_ui "DVD_RUNTIME_INVALID"
mkdir -p "$HOME_DIR/.local/state/openhtpc"
printf '{"schema":1,"kind":"disc_sheet","device":"%s"}\n' "$device" >"$HOME_DIR/.local/state/openhtpc/playback-context.json"
chmod 0600 "$HOME_DIR/.local/state/openhtpc/playback-context.json"
log="$HOME_DIR/.local/state/openhtpc/playback.log"; mpv_bin="$(command -v mpv 2>/dev/null)" || fail_and_return_ui "MPV_UNAVAILABLE"
generation="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("generation",0))' "$state" 2>/dev/null || printf 0)"

readahead_args=()
if [[ -x $INSTALL/openhtpc-readahead.py ]]; then
    readahead_json="$("$INSTALL/openhtpc-readahead.py" --source=OPTICAL --json 2>/dev/null || true)"
    if [[ -n "$readahead_json" ]]; then
        while IFS= read -r arg; do
            [[ -n "$arg" ]] && readahead_args+=("$arg")
        done < <(python3 -c 'import json,sys
try:
    d=json.loads(sys.argv[1])
    for opt in d.get("mpv_options",[]): print(opt)
except Exception: pass' "$readahead_json" 2>/dev/null)
        readahead_target="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("target_readahead_seconds",0))' "$readahead_json" 2>/dev/null || printf 0)"
        readahead_max="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("maximum_cache_bytes",0))' "$readahead_json" 2>/dev/null || printf 0)"
        [[ ! -x $INSTALL/openhtpc-runtime.py ]] || "$INSTALL/openhtpc-runtime.py" log --component playback --event READAHEAD_POLICY_APPLIED --source OPTICAL --target "$readahead_target" --cache_bytes "$readahead_max"
    fi
fi
if [[ ${#readahead_args[@]} -eq 0 ]]; then
    readahead_args=(--cache=yes --demuxer-readahead-secs=12.0 --demuxer-max-bytes=268435456 --demuxer-max-back-bytes=67108864 --demuxer-thread=yes --cache-pause=yes --cache-pause-initial=no --cache-pause-wait=1 --cache-on-disk=no)
fi

[[ ! -x $INSTALL/openhtpc-runtime.py ]] || "$INSTALL/openhtpc-runtime.py" log --component playback --event PLAYBACK_BEGIN
[[ ! -x $INSTALL/openhtpc-runtime.py ]] || "$INSTALL/openhtpc-runtime.py" log --component playback --event PLAYBACK_DISPATCHED
printf '%s kind=dvd device=%q optical_generation=%q runtime=%q mpv=%q readahead=%q\n' "$(date --iso-8601=seconds)" "$device" "$generation" "$runtime" "$mpv_bin" "${readahead_args[*]}" >>"$log"
[[ ! -x $INSTALL/openhtpc-runtime.py ]] || "$INSTALL/openhtpc-runtime.py" log --component playback --event PLAYBACK_PROCESS_STARTED
# Dev32: one persistent policy feeds presentation, audio and subtitles.
# RC2 migration compatibility remains in openhtpc-playback-policy.py: video-profile.json.
policy_json="$(python3 "$INSTALL/openhtpc-playback-policy.py" --home "$HOME_DIR" resolve --kind dvd --dvd-state "$OPTICAL_STATE" 2>/dev/null || printf '{"presentation":{"requested":"PURE","resolved":"PURE","reason":"policy_fallback"},"audio":{"requested":"AUTO","resolved":"MPV_AUTO","reason":"policy_fallback","mpv_args":[]},"subtitle":{"requested":"AUTO","resolved":"MPV_AUTO","reason":"policy_fallback","mpv_args":[]},"mpv_args":[]}')"
video_profile="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1])["presentation"]["requested"])' "$policy_json" 2>/dev/null || printf PURE)"
policy_args=()
while IFS= read -r policy_opt; do [[ -n $policy_opt ]] && policy_args+=("$policy_opt"); done < <(python3 -c 'import json,sys
for value in json.loads(sys.argv[1]).get("mpv_args",[]): print(value)' "$policy_json" 2>/dev/null)

resolved_presentation="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1])["presentation"]["resolved"])' "$policy_json" 2>/dev/null || printf PURE)"
presentation_reason="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1])["presentation"].get("reason","policy_fallback"))' "$policy_json" 2>/dev/null || printf policy_fallback)"

presentation_label="PURE"
[[ "$video_profile" != "CINEMA_AUTO" ]] || presentation_label="MAGNIFICENCE"
osd_text="$(python3 -c 'import importlib.util,json,sys
spec=importlib.util.spec_from_file_location("policy",sys.argv[1]);module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
decision=json.loads(sys.argv[2]);decision["presentation"]["resolved"]=sys.argv[3];print(module.osd_text(decision))' "$INSTALL/openhtpc-playback-policy.py" "$policy_json" "$resolved_presentation" 2>/dev/null || printf 'Politique vidéo : %s\nProfil appliqué : %s\nAudio : Auto\nSous-titres : Auto' "$presentation_label" "$resolved_presentation")"
audio_requested="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1])["audio"]["requested"])' "$policy_json")"
audio_resolved="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1])["audio"]["resolved"])' "$policy_json")"
subtitle_requested="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1])["subtitle"]["requested"])' "$policy_json")"
subtitle_resolved="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1])["subtitle"]["resolved"])' "$policy_json")"
subtitle_reason="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1])["subtitle"]["reason"])' "$policy_json")"
output_requested="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_output",{}).get("requested","PCM"))' "$policy_json")"
output_codec="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_output",{}).get("source_codec","UNKNOWN"))' "$policy_json")"
output_resolved="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_output",{}).get("resolved","PCM"))' "$policy_json")"
output_reason="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_output",{}).get("reason","policy_fallback"))' "$policy_json")"
output_spdif="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_output",{}).get("audio_spdif","none"))' "$policy_json")"
[[ ! -x $INSTALL/openhtpc-runtime.py ]] || "$INSTALL/openhtpc-runtime.py" log --component playback --event PLAYBACK_POLICY \
    --field "presentation_requested=$video_profile" --field "presentation_resolved=$resolved_presentation" --field "presentation_reason=$presentation_reason" \
    --field "audio_requested=$audio_requested" --field "audio_resolved=$audio_resolved" \
    --field "subtitle_requested=$subtitle_requested" --field "subtitle_resolved=$subtitle_resolved" --field "subtitle_reason=$subtitle_reason"
[[ ! -x $INSTALL/openhtpc-runtime.py ]] || "$INSTALL/openhtpc-runtime.py" log --component playback --event AUDIO_POLICY \
    --field "requested=$output_requested" --field "source_codec=$output_codec" --field "resolved=$output_resolved" \
    --field "reason=$output_reason" --field "audio_spdif=$output_spdif"

target_configured="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_target",{}).get("configured","SYSTEM"))' "$policy_json" 2>/dev/null || printf SYSTEM)"
target_label="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_target",{}).get("configured_label","SYSTEM"))' "$policy_json" 2>/dev/null || printf SYSTEM)"
target_available="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_target",{}).get("available",True))' "$policy_json" 2>/dev/null || printf True)"
target_effective="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_target",{}).get("effective","SYSTEM"))' "$policy_json" 2>/dev/null || printf SYSTEM)"
target_fallback="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_target",{}).get("fallback",False))' "$policy_json" 2>/dev/null || printf False)"

[[ ! -x $INSTALL/openhtpc-runtime.py ]] || "$INSTALL/openhtpc-runtime.py" log --component playback --event AUDIO_ROUTING \
    --field "configured=$target_configured" --field "configured_label=$target_label" \
    --field "available=$target_available" --field "effective=$target_effective" \
    --field "audio_mode=$output_requested" --field "fallback=$target_fallback"

pw_diag_json="$(python3 "$INSTALL/openhtpc-playback-policy.py" --home "$HOME_DIR" prepare-bitstream --decision "$policy_json" 2>/dev/null || printf '{}')"
if [[ -n "$pw_diag_json" && "$pw_diag_json" != "{}" && -x $INSTALL/openhtpc-runtime.py ]]; then
    pw_status="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("iec958_prepare_status",""))' "$pw_diag_json" 2>/dev/null || true)"
    pw_reason="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("iec958_prepare_reason",""))' "$pw_diag_json" 2>/dev/null || true)"
    pw_attempted="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("iec958_prepare_attempted",""))' "$pw_diag_json" 2>/dev/null || true)"
    pw_sink_id="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_sink_id",""))' "$pw_diag_json" 2>/dev/null || true)"
    "$INSTALL/openhtpc-runtime.py" log --component playback --event AUDIO_PIPEWIRE_PREPARATION \
        --field "status=$pw_status" --field "reason=$pw_reason" \
        --field "attempted=$pw_attempted" --field "sink_id=$pw_sink_id"
fi

gpu_status="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("gpu_render_binding",json.loads(sys.argv[1]).get("gpu_binding",{})).get("status","AUTO_FALLBACK"))' "$policy_json" 2>/dev/null || printf AUTO_FALLBACK)"
gpu_pci="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("gpu_render_binding",json.loads(sys.argv[1]).get("gpu_binding",{})).get("pci_address",""))' "$policy_json" 2>/dev/null || true)"
gpu_drm="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("gpu_render_binding",json.loads(sys.argv[1]).get("gpu_binding",{})).get("drm_render_path",""))' "$policy_json" 2>/dev/null || true)"
gpu_vulkan="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("gpu_render_binding",json.loads(sys.argv[1]).get("gpu_binding",{})).get("vulkan_uuid",""))' "$policy_json" 2>/dev/null || true)"
gpu_reason="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("gpu_render_binding",json.loads(sys.argv[1]).get("gpu_binding",{})).get("reason",""))' "$policy_json" 2>/dev/null || true)"
[[ ! -x $INSTALL/openhtpc-runtime.py ]] || "$INSTALL/openhtpc-runtime.py" log --component playback --event GPU_RENDER_BINDING \
    --field "status=$gpu_status" --field "pci_address=$gpu_pci" \
    --field "drm_render_path=$gpu_drm" --field "vulkan_uuid=$gpu_vulkan" \
    --field "reason=$gpu_reason"

dispatch_id="$(python3 - "$INSTALL/openhtpc-playback-policy.py" "$HOME_DIR" "$policy_json" <<'PY' 2>/dev/null || true
import importlib.util,json,pathlib,sys
spec=importlib.util.spec_from_file_location("p",sys.argv[1]);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
if hasattr(m, "record_playback_dispatch"):
    rec=m.record_playback_dispatch(pathlib.Path(sys.argv[2]),json.loads(sys.argv[3]),kind="dvd")
    if isinstance(rec, dict):
        print(rec.get("dispatch_id",""))
PY
)"

dvd_attempt="$(mktemp "$HOME_DIR/.local/state/openhtpc/dvd-mpv.XXXXXX.log")"
refresh_runner=()
[[ ! -f $INSTALL/openhtpc-refresh-match.py ]] || refresh_runner=(python3 "$INSTALL/openhtpc-refresh-match.py" --)
"${refresh_runner[@]}" "$mpv_bin" --no-config --include="$runtime" "${readahead_args[@]}" "${policy_args[@]}" --log-file="$dvd_attempt" --osd-playing-msg-duration=5000 --osd-align-x=left --osd-align-y=top --osd-margin-x=48 --osd-margin-y=48 --osd-font-size=32 --osd-playing-msg="$osd_text" --fullscreen=yes --force-window=immediate --border=no --terminal=no --dvd-device="$device" -- dvd://longest 2>>"$log"
rc=$?
audio_observed_json="$(python3 - "$INSTALL/openhtpc-playback-policy.py" "$HOME_DIR" "$policy_json" "$dvd_attempt" "$rc" "${dispatch_id:-}" <<'PY'
import importlib.util,json,pathlib,sys
spec=importlib.util.spec_from_file_location("openhtpc_dvd_audio_observation",sys.argv[1]);module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
home=pathlib.Path(sys.argv[2]);decision=json.loads(sys.argv[3]);raw=pathlib.Path(sys.argv[4]).read_text(encoding="utf-8",errors="replace")
rc=int(sys.argv[5]) if len(sys.argv)>5 and sys.argv[5].isdigit() else 0
disp_id=sys.argv[6] if len(sys.argv)>6 and sys.argv[6] else None
if hasattr(module, "record_playback_observation"):
    module.record_playback_observation(home, decision, raw, exit_code=rc, kind="dvd", dispatch_id=disp_id)
print(json.dumps(module.record_audio_observation(home,decision,raw),sort_keys=True))
PY
)"
rm -f -- "$dvd_attempt"
if [[ -n $audio_observed_json && -x $INSTALL/openhtpc-runtime.py ]]; then
    observed_resolved="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("resolved","PCM"))' "$audio_observed_json")"
    observed_passthrough="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("passthrough","UNKNOWN"))' "$audio_observed_json")"
    observed_ao="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("ao","UNKNOWN"))' "$audio_observed_json")"
    observed_device="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("audio_device","DEFAULT"))' "$audio_observed_json")"
    "$INSTALL/openhtpc-runtime.py" log --component playback --event AUDIO_POLICY_OBSERVED \
        --field "requested=$output_requested" --field "source_codec=$output_codec" --field "resolved=$observed_resolved" \
        --field "passthrough=$observed_passthrough" --field "ao=$observed_ao" --field "audio_device=$observed_device"
fi
[[ ! -x $INSTALL/openhtpc-system-action ]] || "$INSTALL/openhtpc-system-action" audio >/dev/null 2>&1 || true
printf '%s kind=dvd exit_code=%s gpu_render_binding=%q gpu_binding=%q\n' "$(date --iso-8601=seconds)" "$rc" "$gpu_status" "$gpu_status" >>"$log"
[[ ! -x $INSTALL/openhtpc-runtime.py ]] || "$INSTALL/openhtpc-runtime.py" log --component playback --event PLAYBACK_PROCESS_EXITED
[[ ! -x $INSTALL/openhtpc-runtime.py ]] || "$INSTALL/openhtpc-runtime.py" log --component playback --event PLAYBACK_END
if [[ $rc -ne 0 ]] && command -v kdialog >/dev/null 2>&1 && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
    kdialog --title OPENHTPC --error "La lecture du DVD a échoué (code $rc)." || true
fi
return_ui
