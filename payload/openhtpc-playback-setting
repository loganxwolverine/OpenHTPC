from __future__ import annotations

import importlib.util
import os
import pathlib
import subprocess
import sys
import tempfile


def load(path: pathlib.Path):
    spec = importlib.util.spec_from_file_location("openhtpc_playback_policy_setting", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def refresh_dvd_mode_label(home: pathlib.Path, value: str) -> None:
    """Synchronize the derived DVD shortcut label in the active Flex config."""
    target = home / ".config/openhtpc/flex-v1.ini"
    try:
        lines = target.read_text(encoding="utf-8").splitlines(keepends=True)
    except OSError:
        return
    label = "CINÉMA AUTO" if value == "CINEMA_AUTO" else "PURE"
    section = ""
    changed = False
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
        elif section == "DISQUE" and stripped.startswith("Entry") and "=MODE VIDÉO : " in line:
            prefix, rest = line.split("=", 1)
            _old, separator, suffix = rest.partition(";")
            if separator:
                lines[index] = f"{prefix}=MODE VIDÉO : {label};{suffix}"
                changed = True
    if not changed:
        return
    fd, temporary = tempfile.mkstemp(prefix=target.name + ".", dir=target.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.writelines(lines); stream.flush(); os.fsync(stream.fileno())
        os.chmod(temporary, 0o600); os.replace(temporary, target)
    finally:
        if os.path.exists(temporary): os.unlink(temporary)


def refresh_audio_mode_label(home: pathlib.Path, value: str) -> None:
    """Synchronize the AUDIO parent label before Flex reloads it."""
    target = home / ".config/openhtpc/flex-v1.ini"
    try: lines = target.read_text(encoding="utf-8").splitlines(keepends=True)
    except OSError: return
    section = ""; changed = False
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"): section = stripped[1:-1]
        elif section == "SYSTEM_AUDIO" and stripped.startswith("Entry") and "=MODE AUDIO : " in line:
            prefix, rest = line.split("=", 1); _old, separator, suffix = rest.partition(";")
            if separator: lines[index] = f"{prefix}=MODE AUDIO : {value};{suffix}"; changed = True
    if not changed: return
    fd, temporary = tempfile.mkstemp(prefix=target.name + ".", dir=target.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.writelines(lines); stream.flush(); os.fsync(stream.fileno())
        os.chmod(temporary, 0o600); os.replace(temporary, target)
    finally:
        if os.path.exists(temporary): os.unlink(temporary)


def main() -> int:
    if len(sys.argv) != 3:
        return 2
    home = pathlib.Path(os.environ.get("OPENHTPC_HOME", pathlib.Path.home()))
    install = pathlib.Path(os.environ.get("OPENHTPC_INSTALL_DIR", pathlib.Path(__file__).resolve().parent))
    policy = load(install / "openhtpc-playback-policy.py")
    policy.write_preference(home, sys.argv[1], sys.argv[2])
    if sys.argv[1] == "presentation_mode":
        refresh_dvd_mode_label(home, sys.argv[2])
    if sys.argv[1] == "audio_output_mode":
        refresh_audio_mode_label(home, sys.argv[2])
    refresh = install / "openhtpc-system-action"
    if refresh.is_file():
        subprocess.run([str(refresh), "audio" if sys.argv[1] == "audio_output_mode" else "playback"], check=False, timeout=15)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
