from __future__ import annotations

import importlib.util
import functools
import os
import pathlib
import subprocess
import sys
import tempfile


def load(path: pathlib.Path):
    spec = importlib.util.spec_from_file_location("openhtpc_playback_policy_setting", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def serialized_flex_refresh(function):
    """Keep each Flex label read and replacement in one publication transaction."""
    @functools.wraps(function)
    def wrapped(home: pathlib.Path, *args, **kwargs):
        engine_path = pathlib.Path(os.environ.get(
            "OPENHTPC_SESSION_ENGINE",
            pathlib.Path(__file__).resolve().with_name("openhtpc-session-engine.py"),
        ))
        engine = load(engine_path)
        with engine.flex_publication_lock(home):
            return function(home, *args, **kwargs)
    return wrapped


@serialized_flex_refresh
def refresh_dvd_mode_label(home: pathlib.Path, value: str) -> None:
    """Synchronize the derived DVD shortcut label in the active Flex config."""
    target = home / ".config/openhtpc/flex-v1.ini"
    try:
        lines = target.read_text(encoding="utf-8").splitlines(keepends=True)
    except OSError:
        return
    label = "CINÉMA AUTO" if value == "CINEMA_AUTO" else "PURE"
    section = ""
    changed = False
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
        elif section == "DISQUE" and stripped.startswith("Entry") and "=MODE VIDÉO : " in line:
            prefix, rest = line.split("=", 1)
            _old, separator, suffix = rest.partition(";")
            if separator:
                lines[index] = f"{prefix}=MODE VIDÉO : {label};{suffix}"
                changed = True
    if not changed:
        return
    fd, temporary = tempfile.mkstemp(prefix=target.name + ".", dir=target.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.writelines(lines); stream.flush(); os.fsync(stream.fileno())
        os.chmod(temporary, 0o600); os.replace(temporary, target)
    finally:
        if os.path.exists(temporary): os.unlink(temporary)


