#!/usr/bin/env python3
"""Generate the minimal OPENHTPC Basic power menu."""
import os
import pathlib
import tempfile
import importlib.util

home = pathlib.Path(os.environ.get("OPENHTPC_HOME", pathlib.Path.home()))
install = pathlib.Path(os.environ.get("OPENHTPC_INSTALL_DIR", home / ".local/lib/openhtpc"))
menu = home / ".config/openhtpc/power.ini"
quit_icon = install / "assets/ui/quit.png"
power_icon = install / "assets/ui/power.png"
back_icon = install / "assets/ui/system-back.png"
font = install / "flex/assets/fonts/OpenSans-Regular.ttf"
session = install / "openhtpc-session-start"
spec = importlib.util.spec_from_file_location("power_theme", install / "openhtpc-theme.py")
theme = importlib.util.module_from_spec(spec); spec.loader.exec_module(theme)
quit_openhtpc = install / "openhtpc-quit"
content = f"""[General]
DefaultMenu=Alimentation
VSync=true
OnLaunch=Blank
WrapEntries=true
MouseSelect=true
{theme.background_block(install, 62)}
[Layout]
MaxButtons=3
IconSize=210
IconSpacing=3%
VCenter=50%
{theme.title_block(font, 48, 22)}
{theme.highlight_block(accent=True)}
[Hotkeys]
Hotkey1=#1B;:replace {session}
Hotkey2=#08;:replace {session}
[Alimentation]
Entry1=QUITTER OPENHTPC;{quit_icon};:replace {quit_openhtpc}
Entry2=ÉTEINDRE LE PC;{power_icon};systemctl poweroff
Entry3=RETOUR;{back_icon};:replace {session}
"""
menu.parent.mkdir(parents=True, exist_ok=True)
fd, name = tempfile.mkstemp(prefix=menu.name + ".", dir=menu.parent)
with os.fdopen(fd, "w", encoding="utf-8") as stream:
    stream.write(content)
os.chmod(name, 0o600)
os.replace(name, menu)
os.execv(install / "flex/bin/flex-launcher", [str(install / "flex/bin/flex-launcher"), "-c", str(menu)])
