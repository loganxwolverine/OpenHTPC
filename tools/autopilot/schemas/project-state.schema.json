{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "architectural_boundary": {"const": "FROZEN_AFTER_PHASE11"},
    "core_remains_owner_of": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
    "current_phase": {"enum": ["P2_PRODUCTION_CUTOVER_SOFTWARE_COMPLETE", "P2_PRODUCTION_CUTOVER_PHYSICALLY_QUALIFIED", "P2_RC1_PREPARED_AWAITING_PHYSICAL_RELEASE_GATE", "P2_RC2_STABILIZATION_IMPLEMENTED_AWAITING_PHYSICAL_VALIDATION", "P2_RC2_CANDIDATE_PREPARED_AWAITING_PHYSICAL_VALIDATION", "P2_RC2_PHYSICAL_GATE_NO_GO_RC3_STABILIZATION_IMPLEMENTED", "P2_RC3_CANDIDATE_PREPARED_AWAITING_PHYSICAL_VALIDATION", "P2_RC4_CANDIDATE_PREPARED_AWAITING_PHYSICAL_VALIDATION", "P2_RC5_CANDIDATE_PREPARED_AWAITING_PHYSICAL_VALIDATION"], "type": "string"},
    "default_behavior_change_expected": {"type": "boolean"},
    "dev13_physical_qualification": {"const": "FAILED_DISABLED_UI_GATING"},
    "dev14_physical_qualification": {"enum": ["PENDING", "PASS"], "type": "string"},
    "hardware_io_ownership_change": {"type": "boolean"},
    "next_action": {"enum": ["PHYSICAL_VALIDATION", "RC_PREPARATION", "RC_PHYSICAL_RELEASE_GATE", "RC2_PHYSICAL_STABILIZATION_VALIDATION", "AWAIT_RC3_PREPARATION_AUTHORIZATION", "RC3_PHYSICAL_VALIDATION", "RC4_PHYSICAL_VALIDATION", "RC5_PHYSICAL_VALIDATION"], "type": "string"},
    "next_action_context": {
      "additionalProperties": false,
      "properties": {
        "broken": {"type": "string"},
        "disabled": {"type": "string"},
        "enabled_valid": {"type": "string"},
        "plugin_absent": {"type": "string"}
      },
      "required": ["plugin_absent", "disabled", "enabled_valid", "broken"],
      "type": "object"
    },
    "next_action_kind": {"enum": ["PHYSICAL", "RELEASE_PREPARATION"], "type": "string"},
    "next_step_after_software": {"enum": ["STOP_FOR_PHYSICAL_VALIDATION", "QUALIFIED_CANDIDATE_FOR_RC_PREPARATION", "STOP_FOR_RC_PHYSICAL_RELEASE_GATE", "STOP_FOR_RC2_PHYSICAL_STABILIZATION_VALIDATION", "STOP_BEFORE_RC3_PREPARATION", "STOP_FOR_RC3_PHYSICAL_VALIDATION", "STOP_FOR_RC4_PHYSICAL_VALIDATION", "STOP_FOR_RC5_PHYSICAL_VALIDATION"], "type": "string"},
    "ownership_migration_status": {"const": "COMPLETE"},
    "physical_validation_required_after_implementation": {"type": "boolean"},
    "plugin_cutover_status": {"const": "COMPLETE"},
    "plugin_policy_feature_owner": {"const": "plugin.bluray"},
    "qualification": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "additionalProperties": false,
          "properties": {
            "build": {"minLength": 1, "type": "string"},
            "filename": {"minLength": 1, "type": "string"},
            "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "version": {"minLength": 1, "type": "string"}
          },
          "required": ["filename", "sha256", "version", "build"],
          "type": "object"
        },
        "candidate_status": {"enum": ["QUALIFIED_CANDIDATE_FOR_RC_PREPARATION"], "type": "string"},
        "limitations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "blocking": {"type": "boolean"},
              "description": {"minLength": 1, "type": "string"},
              "id": {"pattern": "^[A-Z0-9_]+$", "type": "string"},
              "status": {"enum": ["DEFERRED", "KNOWN_LIMITATION", "OPERATIONAL_REQUIREMENT"], "type": "string"}
            },
            "required": ["id", "status", "blocking", "description"],
            "type": "object"
          },
          "type": "array"
        },
        "platforms": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "family": {"enum": ["INTEL", "AMD", "NVIDIA"], "type": "string"},
              "model": {"minLength": 1, "type": "string"},
              "status": {"enum": ["PENDING", "PASS", "FAIL"], "type": "string"}
            },
            "required": ["family", "model", "status"],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "qualified_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "scenarios": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {"pattern": "^[A-Z0-9_]+$", "type": "string"},
              "status": {"enum": ["PENDING", "PASS", "FAIL", "NOT_APPLICABLE"], "type": "string"}
            },
            "required": ["id", "status"],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "status": {"enum": ["PENDING", "PASS", "FAIL"], "type": "string"}
      },
      "required": ["status", "candidate_status", "qualified_commit", "artifact", "platforms", "scenarios", "limitations"],
      "type": "object"
    },
    "release_candidate": {
      "additionalProperties": false,
      "properties": {
        "artifact_filename": {"minLength": 1, "type": "string"},
        "build": {"minLength": 1, "type": "string"},
        "functional_changes_since_qualified_baseline": {"const": false},
        "origin_qualified_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "origin_qualified_version": {"minLength": 1, "type": "string"},
        "physical_qualification": {"enum": ["PENDING", "PASS", "FAIL", "NO_GO"], "type": "string"},
        "physical_release_gate_reasons": {"items": {"type": "string"}, "type": "array"},
        "status": {"enum": ["PROMOTED_FROM_PHYSICALLY_QUALIFIED_BASELINE_AWAITING_RELEASE_GATE", "RC1_PHYSICAL_RELEASE_GATE_NO_GO"], "type": "string"},
        "version": {"minLength": 1, "type": "string"}
      },
      "required": ["version", "build", "artifact_filename", "status", "physical_qualification", "origin_qualified_version", "origin_qualified_commit", "functional_changes_since_qualified_baseline"],
      "type": "object"
    },
    "rc2_candidate": {
      "additionalProperties": false,
      "properties": {
        "artifact_prepared": {"type": "boolean"},
        "build": {"minLength": 1, "type": "string"},
        "filename": {"minLength": 1, "type": "string"},
        "physical_evidence": {"items": {"type": "string"}, "type": "array"},
        "physical_qualification": {"const": "PHYSICAL_GATE_NO_GO"},
        "protected_bluray_bitstream_fix": {"const": "SOFTWARE_PASS_PHYSICAL_FAIL_STEREO"},
        "purpose": {"const": "STABILIZATION_ONLY_NO_NEW_FEATURES"},
        "status": {"const": "PHYSICAL_GATE_NO_GO"},
        "uhd_open_failed": {"const": "EXTERNAL_AACS_PER_DISC_OR_ENVIRONMENT_LIMITATION_NON_BLOCKING"},
        "version": {"const": "1.2.0-rc2"}
      },
      "required": ["artifact_prepared", "build", "filename", "physical_evidence", "physical_qualification", "protected_bluray_bitstream_fix", "purpose", "status", "uhd_open_failed", "version"],
      "type": "object"
    },
    "rc3_candidate": {
      "additionalProperties": false,
      "properties": {
        "artifact_prepared": {"type": "boolean"},
        "build": {"minLength": 1, "type": "string"},
        "filename": {"minLength": 1, "type": "string"},
        "physical_evidence": {"items": {"type": "string"}, "type": "array"},
        "physical_qualification": {"const": "PHYSICAL_GATE_NO_GO"},
        "purpose": {"const": "DETERMINISTIC_BITSTREAM_POLICY_CONTRACT"},
        "status": {"const": "PHYSICAL_GATE_NO_GO"},
        "version": {"const": "1.2.0-rc3"}
      },
      "required": ["artifact_prepared", "build", "filename", "physical_evidence", "physical_qualification", "purpose", "status", "version"],
      "type": "object"
    },
    "rc4_candidate": {
      "additionalProperties": false,
      "properties": {
        "artifact_prepared": {"type": "boolean"},
        "build": {"minLength": 1, "type": "string"},
        "filename": {"minLength": 1, "type": "string"},
        "physical_evidence": {"items": {"type": "string"}, "type": "array"},
        "physical_qualification": {"enum": ["PHYSICAL_BITSTREAM_PASS_DIAG_FALSE_NEGATIVE", "PHYSICAL_GATE_NO_GO", "PASS", "PENDING_PHYSICAL_VALIDATION_NOT_QUALIFIED"]},
        "purpose": {"minLength": 1, "type": "string"},
        "status": {"minLength": 1, "type": "string"},
        "version": {"const": "1.2.0-rc4"}
      },
      "required": ["artifact_prepared", "build", "filename", "physical_evidence", "physical_qualification", "purpose", "status", "version"],
      "type": "object"
    },
    "next_candidate": {
      "additionalProperties": false,
      "properties": {
        "artifact_prepared": {"type": "boolean"},
        "build": {"enum": ["public-release-1.2.0-rc4", "public-release-1.2.0-rc5", "public-release-1.2.0-rc6", "public-release-1.2.0-rc7"]},
        "filename": {"enum": ["OpenHTPC-1.2.0-RC4.tar.gz", "OpenHTPC-1.2.0-RC5.tar.gz", "OpenHTPC-1.2.0-RC6.tar.gz", "OpenHTPC-1.2.0-RC7.tar.gz"]},
        "media_audio_fix": {"enum": ["MEDIA_PIPEWIRE_IEC958_RECOVERY", "HD_BITSTREAM_DISPLAY_RESYNC_LIFECYCLE"]},
        "physical_qualification": {"enum": ["NOT_STARTED", "PENDING_PHYSICAL_VALIDATION", "PENDING_PHYSICAL_VALIDATION_NOT_QUALIFIED"]},
        "protected_bluray_audio_fix": {"enum": ["PIPEWIRE_HDMI_HD_PASSTHROUGH_PREPARATION", "PIPEWIRE_EFFECTIVE_IEC958_VERIFICATION"]},
        "purpose": {"enum": ["PROTECTED_BLURAY_PIPEWIRE_HD_PASSTHROUGH_PREPARATION", "PROTECTED_BLURAY_PIPEWIRE_EFFECTIVE_IEC958_VERIFICATION", "MEDIA_PIPEWIRE_IEC958_RECOVERY", "SALON_PLAYBACK_AND_RUNTIME_STABILITY"]},
        "status": {"enum": ["NOT_PREPARED_NOT_QUALIFIED", "PENDING_PHYSICAL_VALIDATION_NOT_QUALIFIED"]},
        "version": {"enum": ["1.2.0-rc4", "1.2.0-rc5", "1.2.0-rc6", "1.2.0-rc7"]}
      },
      "required": ["artifact_prepared", "physical_qualification", "purpose", "status", "version"],
      "type": "object"
    },
    "required_gate_reason": {"enum": ["PHYSICAL_VALIDATION", "RELEASE", "PHYSICAL_BITSTREAM_AND_STABILIZATION_VALIDATION"], "type": "string"},
    "required_human_gate_stage": {"const": "BEFORE_EXECUTION"},
    "schema_version": {"const": 1},
    "security_boundary_change": {"type": "boolean"},
    "software_implementation_allowed": {"type": "boolean"},
    "ui_gating_regression_fix": {"const": "COMPLETE"},
    "workstream": {"const": "PROTECTED_OPTICAL_PLUGIN_FRAMEWORK_P2"}
  },
  "required": [
    "schema_version", "workstream", "current_phase", "architectural_boundary",
    "ownership_migration_status", "plugin_cutover_status", "next_action",
    "next_action_kind", "software_implementation_allowed",
    "physical_validation_required_after_implementation", "required_human_gate_stage",
    "required_gate_reason", "default_behavior_change_expected",
    "dev13_physical_qualification", "dev14_physical_qualification",
    "hardware_io_ownership_change", "security_boundary_change",
    "next_step_after_software", "plugin_policy_feature_owner",
    "core_remains_owner_of", "next_action_context", "ui_gating_regression_fix"
  ],
  "type": "object"
}
