{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "architectural_boundary": {"const": "FROZEN_AFTER_PHASE11"},
    "core_remains_owner_of": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
    "current_phase": {"enum": ["P2_PRODUCTION_CUTOVER_SOFTWARE_COMPLETE", "P2_PRODUCTION_CUTOVER_PHYSICALLY_QUALIFIED"], "type": "string"},
    "default_behavior_change_expected": {"type": "boolean"},
    "dev13_physical_qualification": {"const": "FAILED_DISABLED_UI_GATING"},
    "dev14_physical_qualification": {"enum": ["PENDING", "PASS"], "type": "string"},
    "hardware_io_ownership_change": {"type": "boolean"},
    "next_action": {"enum": ["PHYSICAL_VALIDATION", "RC_PREPARATION"], "type": "string"},
    "next_action_context": {
      "additionalProperties": false,
      "properties": {
        "broken": {"type": "string"},
        "disabled": {"type": "string"},
        "enabled_valid": {"type": "string"},
        "plugin_absent": {"type": "string"}
      },
      "required": ["plugin_absent", "disabled", "enabled_valid", "broken"],
      "type": "object"
    },
    "next_action_kind": {"enum": ["PHYSICAL", "RELEASE_PREPARATION"], "type": "string"},
    "next_step_after_software": {"enum": ["STOP_FOR_PHYSICAL_VALIDATION", "QUALIFIED_CANDIDATE_FOR_RC_PREPARATION"], "type": "string"},
    "ownership_migration_status": {"const": "COMPLETE"},
    "physical_validation_required_after_implementation": {"type": "boolean"},
    "plugin_cutover_status": {"const": "COMPLETE"},
    "plugin_policy_feature_owner": {"const": "plugin.bluray"},
    "qualification": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "additionalProperties": false,
          "properties": {
            "build": {"minLength": 1, "type": "string"},
            "filename": {"minLength": 1, "type": "string"},
            "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "version": {"minLength": 1, "type": "string"}
          },
          "required": ["filename", "sha256", "version", "build"],
          "type": "object"
        },
        "candidate_status": {"enum": ["QUALIFIED_CANDIDATE_FOR_RC_PREPARATION"], "type": "string"},
        "limitations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "blocking": {"type": "boolean"},
              "description": {"minLength": 1, "type": "string"},
              "id": {"pattern": "^[A-Z0-9_]+$", "type": "string"},
              "status": {"enum": ["DEFERRED", "KNOWN_LIMITATION", "OPERATIONAL_REQUIREMENT"], "type": "string"}
            },
            "required": ["id", "status", "blocking", "description"],
            "type": "object"
          },
          "type": "array"
        },
        "platforms": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "family": {"enum": ["INTEL", "AMD", "NVIDIA"], "type": "string"},
              "model": {"minLength": 1, "type": "string"},
              "status": {"enum": ["PENDING", "PASS", "FAIL"], "type": "string"}
            },
            "required": ["family", "model", "status"],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "qualified_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "scenarios": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {"pattern": "^[A-Z0-9_]+$", "type": "string"},
              "status": {"enum": ["PENDING", "PASS", "FAIL", "NOT_APPLICABLE"], "type": "string"}
            },
            "required": ["id", "status"],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "status": {"enum": ["PENDING", "PASS", "FAIL"], "type": "string"}
      },
      "required": ["status", "candidate_status", "qualified_commit", "artifact", "platforms", "scenarios", "limitations"],
      "type": "object"
    },
    "required_gate_reason": {"enum": ["PHYSICAL_VALIDATION", "RELEASE"], "type": "string"},
    "required_human_gate_stage": {"const": "BEFORE_EXECUTION"},
    "schema_version": {"const": 1},
    "security_boundary_change": {"type": "boolean"},
    "software_implementation_allowed": {"type": "boolean"},
    "ui_gating_regression_fix": {"const": "COMPLETE"},
    "workstream": {"const": "PROTECTED_OPTICAL_PLUGIN_FRAMEWORK_P2"}
  },
  "required": [
    "schema_version", "workstream", "current_phase", "architectural_boundary",
    "ownership_migration_status", "plugin_cutover_status", "next_action",
    "next_action_kind", "software_implementation_allowed",
    "physical_validation_required_after_implementation", "required_human_gate_stage",
    "required_gate_reason", "default_behavior_change_expected",
    "dev13_physical_qualification", "dev14_physical_qualification",
    "hardware_io_ownership_change", "security_boundary_change",
    "next_step_after_software", "plugin_policy_feature_owner",
    "core_remains_owner_of", "next_action_context", "ui_gating_regression_fix"
  ],
  "type": "object"
}
