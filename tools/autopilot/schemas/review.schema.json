{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","verdict","summary","plan_compliance","architecture_compliance","test_evidence_accepted","scope_compliance","security_findings","physical_validation_required","human_gate_stage","gate_reason","blocking_findings","recommended_next_action"],
