    "plan_compliance":{"type":"boolean"},"architecture_compliance":{"type":"boolean"},"test_evidence_accepted":{"type":"boolean"},"scope_compliance":{"type":"boolean"},
    "security_findings":{"type":"array","items":{"type":"string"}},"physical_validation_required":{"type":"boolean"},
    "human_gate_stage":{"enum":["NONE","BEFORE_EXECUTION","AFTER_IMPLEMENTATION"]},
    "gate_reason":{"enum":["NONE","PHYSICAL_VALIDATION","PUSH","TAG","RELEASE","MERGE","REBASE","DESTRUCTIVE_GIT","SECURITY_BOUNDARY","HARDWARE_IO_OWNERSHIP","CREDENTIAL_OR_SECRET","SYSTEM_CONFIGURATION","OTHER"]},
    "blocking_findings":{"type":"array","items":{"type":"string"}},"recommended_next_action":{"type":"string"}
  }
}
