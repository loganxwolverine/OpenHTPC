# ─── Argument parser ─────────────────────────────────────────────────────────

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="openhtpc-devctl",
        description="OPENHTPC Development Workflow Orchestrator (dev tooling only)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            Normal workflow:
              status             → inspect repo state
              test <profile>     → run focused test suite
              build ...          → produce artifact from HEAD commit
              verify <artifact>  → verify artifact integrity
              ship <artifact>    → SCP to target host
              target-prepare     → snapshot + stop (before install)
              target-install     → install via update.sh
              target-check       → post-install read-only checks
              human-gate         → print validation instructions for Steve
              collect            → collect validation bundle from target
              qualification      → record Steve's physical PASS/FAIL
        """),
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # status
    sub.add_parser("status", help="Show repository status")

    # test
    p_test = sub.add_parser("test", help="Run a named test profile")
    p_test.add_argument("profile", choices=list(TEST_PROFILES), help="Test profile name")

    # build
    p_build = sub.add_parser("build", help="Build artifact from HEAD commit")
    p_build.add_argument("--name", required=True, help="Artifact base name (e.g. OpenHTPC-1.2.0-RC8-Media-Foundation-Dev3)")
    p_build.add_argument("--build-id", required=True, dest="build_id", help="Build ID (e.g. media-probe-dev3)")
    p_build.add_argument("--dev-tranche", required=True, dest="dev_tranche", help="Dev tranche (e.g. DEV3)")
    p_build.add_argument("--workstream", required=True, help="Workstream (e.g. MEDIA_FOUNDATION)")
    p_build.add_argument("--tests", required=True, help='Test summary (e.g. "22/22 PASS")')

    # verify
    p_verify = sub.add_parser("verify", help="Verify artifact integrity")
    p_verify.add_argument("artifact", help="Path to .tar.gz artifact")

    # ship
    p_ship = sub.add_parser("ship", help="Ship artifact to target host")
    p_ship.add_argument("artifact", help="Path to .tar.gz artifact")
    p_ship.add_argument("--target", default=None, help=f"Remote host (default: {DEFAULT_TARGET_HOST})")
    p_ship.add_argument("--dest", default=None, help=f"Remote directory (default: {DEFAULT_TARGET_DIR})")
    p_ship.add_argument("--dry-run", action="store_true", help="Print actions without executing")

    # target-prepare
    p_tp = sub.add_parser("target-prepare", help="Snapshot + stop target before installation")
    p_tp.add_argument("--target", default=None, help=f"Remote host (default: {DEFAULT_TARGET_HOST})")
    p_tp.add_argument("--dry-run", action="store_true", help="Print actions without executing")

    # target-install
    p_ti = sub.add_parser("target-install", help="Install artifact on target via update.sh")
    p_ti.add_argument("artifact", help="Path to .tar.gz artifact")
    p_ti.add_argument("--target", default=None, help=f"Remote host (default: {DEFAULT_TARGET_HOST})")
    p_ti.add_argument("--dest", default=None, help=f"Remote directory (default: {DEFAULT_TARGET_DIR})")
    p_ti.add_argument("--dry-run", action="store_true", help="Print actions without executing")

    # target-check
    p_tc = sub.add_parser("target-check", help="Read-only post-install checks on target")
    p_tc.add_argument("--target", default=None, help=f"Remote host (default: {DEFAULT_TARGET_HOST})")
    p_tc.add_argument("--media-file", default=None, dest="media_file",
                      help="Explicit media file to probe (must be on target host)")

    # collect
    p_collect = sub.add_parser("collect", help="Collect validation bundle from target")
    p_collect.add_argument("--target", default=None, help=f"Remote host (default: {DEFAULT_TARGET_HOST})")

    # human-gate
    sub.add_parser("human-gate", help="Print human validation instructions")

    # qualification
    p_qual = sub.add_parser("qualification", help="Record physical validation results")
    p_qual.add_argument("--artifact", required=True, help="Artifact name or base stem")
    p_qual.add_argument("--image", required=True, choices=["PASS", "FAIL", "SKIP"])
    p_qual.add_argument("--audio", required=True, choices=["PASS", "FAIL", "SKIP"])
    p_qual.add_argument("--refresh", required=True, choices=["PASS", "FAIL", "SKIP"])
    p_qual.add_argument("--flex-return", required=True, dest="flex_return",
                        choices=["PASS", "FAIL", "SKIP"])
    p_qual.add_argument("--refresh-observed-hz", type=int, default=None,
                        help="Observed display refresh rate in Hz")
    p_qual.add_argument("--refresh-limitation", default=None,
                        help="Known refresh limitation identifier if applicable")
    p_qual.add_argument("--refresh-non-regression", choices=["PASS", "FAIL", "SKIP"], default=None,
                        help="Non-regression verdict for refresh behavior")

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    dispatch = {
        "status": cmd_status,
        "test": cmd_test,
        "build": cmd_build,
        "verify": cmd_verify,
        "ship": cmd_ship,
        "target-prepare": cmd_target_prepare,
        "target-install": cmd_target_install,
        "target-check": cmd_target_check,
        "collect": cmd_collect,
        "human-gate": cmd_human_gate,
        "qualification": cmd_qualification,
    }

    fn = dispatch.get(args.command)
    if fn is None:
        print(f"ERROR: Unknown command: {args.command}", file=sys.stderr)
        return 2

    try:
        return fn(args)
    except KeyboardInterrupt:
        print("\nInterrupted.", file=sys.stderr)
        return 130
    except subprocess.CalledProcessError as exc:
        print(f"ERROR: subprocess failed: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
