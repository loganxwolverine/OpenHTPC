def cmd_status(args: argparse.Namespace) -> int:
    _print_header("OPENHTPC DEVCTL — STATUS")

    # Git state
    head_result = _git("rev-parse", "HEAD", check=False)
    short_result = _git("rev-parse", "--short", "HEAD", check=False)
    branch_result = _git("rev-parse", "--abbrev-ref", "HEAD", check=False)
    status_result = _git("status", "--porcelain", check=False)

    head = head_result.stdout.strip() if head_result.returncode == 0 else "UNKNOWN"
    short = short_result.stdout.strip() if short_result.returncode == 0 else "UNKNOWN"
    branch = branch_result.stdout.strip() if branch_result.returncode == 0 else "UNKNOWN"
    porcelain = status_result.stdout.strip() if status_result.returncode == 0 else ""
    dirty = bool(porcelain)
    version = _product_version()

    stash_found, stash_ref = _check_protected_stash()

    print(f"Repository : {ROOT}")
    print(f"Branch     : {branch}")
    print(f"HEAD       : {head}")
    print(f"Short HEAD : {short}")
    print(f"State      : {'DIRTY' if dirty else 'CLEAN'}")
    print(f"Version    : {version}")
    print(f"Protected stash : {'PRESENT (' + stash_ref + ')' if stash_found else 'MISSING — WARNING'}")

    if dirty and porcelain:
        print("\nWorking tree changes:")
        for line in porcelain.splitlines():
            print(f"  {line}")

    # Recent Media Foundation commits
    log_result = _git(
        "log", "--oneline", "-10",
        "--", "payload/openhtpc-media-db.py", "payload/openhtpc-media-probe.py",
        check=False,
    )
    if log_result.returncode == 0 and log_result.stdout.strip():
        print("\nRecent Media Foundation commits:")
        for line in log_result.stdout.strip().splitlines():
            print(f"  {line}")

    _print_separator()
    return 0


def cmd_test(args: argparse.Namespace) -> int:
    profile = args.profile
    if profile not in TEST_PROFILES:
        print(f"ERROR: Unknown test profile '{profile}'", file=sys.stderr)
        print(f"Available profiles: {', '.join(sorted(TEST_PROFILES))}", file=sys.stderr)
        return 2

    test_files = TEST_PROFILES[profile]
    _print_header(f"OPENHTPC DEVCTL — TEST [{profile}]")
    print(f"Profile    : {profile}")
    print(f"Files      : {', '.join(test_files)}")
    print()

    cmd = [sys.executable, "-m", "pytest", "-v"] + test_files
    result = subprocess.run(cmd, cwd=ROOT, check=False, stdin=subprocess.DEVNULL)
    rc = result.returncode
    print()
    _print_separator()
    print(f"  Result: {'PASS' if rc == 0 else 'FAIL'} (exit {rc})")
    _print_separator()
    return rc


def cmd_build(args: argparse.Namespace) -> int:
    name = args.name
    build_id = args.build_id
    dev_tranche = args.dev_tranche
    workstream = args.workstream
    tests = args.tests

    _print_header(f"OPENHTPC DEVCTL — BUILD [{name}]")
    if not ARTIFACT_NAME_PATTERN.fullmatch(name) or name in (".", ".."):
        print("ERROR: Invalid artifact name", file=sys.stderr)
        return 1
    if any(type(value) is not str or not value.strip() for value in (build_id, dev_tranche, workstream, tests)):
        print("ERROR: Build identity and test summary must be nonempty strings", file=sys.stderr)
        return 1

    # Resolve exact commit
    commit_result = _git("rev-parse", "HEAD", check=False)
    if commit_result.returncode != 0:
        print("ERROR: Cannot resolve HEAD commit", file=sys.stderr)
        return 1
    commit = commit_result.stdout.strip()
    if not COMMIT_PATTERN.fullmatch(commit):
        print("ERROR: Invalid HEAD commit", file=sys.stderr)
        return 1

    print(f"Name       : {name}")
    print(f"Build ID   : {build_id}")
    print(f"Commit     : {commit}")
    print(f"Workstream : {workstream}")
    print(f"Dev tranche: {dev_tranche}")
    print(f"Tests      : {tests}")

    # Warn if dirty
    status_result = _git("status", "--porcelain", check=False)
    if status_result.returncode == 0 and status_result.stdout.strip():
        print("\nWARNING: Working tree is dirty. Archive is built from committed files only.")
        print("         Untracked/modified files will NOT be included in the artifact.")

    ARTIFACTS.mkdir(exist_ok=True)
    archive = ARTIFACTS / f"{name}.tar.gz"
    checksum = ARTIFACTS / f"{name}.tar.gz.sha256"
    report = ARTIFACTS / f"{name}-report.json"

    # Do NOT delete existing artifacts automatically — safety rule
    for path in (archive, checksum, report):
        if path.exists() or path.is_symlink():
            print(f"\nERROR: {path.name} already exists. Delete manually if replacing.", file=sys.stderr)
            return 1

    print("\nExporting exact commit and building Flex from exported source...")
    try:
        with tempfile.TemporaryDirectory(prefix="openhtpc-build-") as raw:
            scratch = pathlib.Path(raw)
            staging = scratch / "stage"
            staging.mkdir()
            _export_commit(commit, staging, scratch)
            version = (staging / "VERSION").read_text(encoding="utf-8").strip()
            if not version:
                raise ValueError("exported VERSION missing or empty")
            flex_source = staging / "vendor/flex-launcher"
            fingerprint = _source_fingerprint(flex_source)
            upstream = (flex_source / "UPSTREAM_COMMIT").read_text(encoding="utf-8").strip()
            if not COMMIT_PATTERN.fullmatch(upstream):
                raise ValueError("exported Flex upstream commit missing or invalid")
            built = _build_flex(flex_source, scratch / "flex-build")
            built_sha = _sha256(built)
            staged = staging / "payload/flex/bin/flex-launcher"
            staged.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(built, staged)
            if _sha256(staged) != built_sha or not os.access(staged, os.X_OK):
                raise ValueError("staged Flex binary differs from fresh build")
            flex_metadata: dict[str, Any] = {
                "schema": 2,
                "binary_sha256": _sha256(staged),
                "elf_build_id": _elf_build_id(staged),
                "source_commit": commit,
                "source_revision": f"upstream-{upstream}+openhtpc-{commit}",
                "upstream_commit": upstream,
                "flex_source_fingerprint": fingerprint,
                "artifact_build_id": build_id,
                "dev_tranche": dev_tranche,
                "workstream": workstream,
                "product_version": version,
            }
            _validate_flex_metadata(flex_metadata)
            meta_path = staging / "payload/flex/BUILD-METADATA.json"
            meta_path.write_text(json.dumps(flex_metadata, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            if json.loads(meta_path.read_text(encoding="utf-8"))["binary_sha256"] != _sha256(staged):
                raise ValueError("staged Flex metadata does not match staged binary")
            _write_manifest(staging)
            _write_archive(staging, name, archive)

        sha = _sha256(archive)
        checksum.write_text(f"{sha}  {archive.name}\n", encoding="utf-8")
        report_data: dict[str, Any] = {
            "schema": 1,
            "artifact": archive.name,
            "build_id": build_id,
            "commit": commit,
            "dev_tranche": dev_tranche,
            "product": "OPENHTPC",
            "sha256": sha,
            "status": f"OPENHTPC_RC8_{workstream}_{dev_tranche}_READY_FOR_PHYSICAL_VALIDATION",
            "tests": tests,
            "version": version,
            "workstream": workstream,
        }
        report.write_text(json.dumps(report_data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        verification_errors = _verify_artifact(archive)
        if verification_errors:
            raise ValueError("final archive provenance verification failed: " + "; ".join(verification_errors))
    except (OSError, ValueError, subprocess.CalledProcessError, tarfile.TarError) as exc:
        for path in (archive, checksum, report):
            path.unlink(missing_ok=True)
        print(f"ERROR: Build failed closed: {exc}", file=sys.stderr)
        return 1

    print()
    print(f"Archive  : {archive}")
    print(f"SHA256   : {sha}")
    print(f"Checksum : {checksum}")
    print(f"Report   : {report}")
    _print_separator()
    print("  BUILD COMPLETE")
    _print_separator()
    return 0


def _validate_flex_metadata(data: Any) -> None:
    if type(data) is not dict or type(data.get("schema")) is not int or data["schema"] != 2:
        raise ValueError("Flex metadata schema invalid")
    for key in (
        "binary_sha256", "elf_build_id", "source_commit", "source_revision",
        "upstream_commit", "flex_source_fingerprint", "artifact_build_id",
        "dev_tranche", "workstream", "product_version",
    ):
        if type(data.get(key)) is not str or not data[key].strip():
            raise ValueError(f"Flex metadata field missing or invalid: {key}")
    for key in ("binary_sha256", "flex_source_fingerprint"):
        if not SHA256_PATTERN.fullmatch(data[key]):
            raise ValueError(f"Flex metadata SHA invalid: {key}")
    for key in ("source_commit", "upstream_commit"):
        if not COMMIT_PATTERN.fullmatch(data[key]):
            raise ValueError(f"Flex metadata commit invalid: {key}")
    if not ELF_BUILD_ID_PATTERN.fullmatch(data["elf_build_id"]):
        raise ValueError("Flex metadata ELF build ID invalid")


def _read_archive_json(tar: tarfile.TarFile, name: str) -> dict[str, Any]:
    member = tar.getmember(name)
    if not member.isfile() or member.size > 1 << 20:
        raise ValueError(f"missing, invalid or oversized JSON member: {name}")
    stream = tar.extractfile(member)
    if stream is None:
        raise ValueError(f"unreadable JSON member: {name}")
    data = json.load(stream)
    if type(data) is not dict:
        raise ValueError(f"JSON member must be an object: {name}")
    return data


def _verify_artifact(archive_path: pathlib.Path) -> list[str]:
    """Independently inspect archive bytes, source tree and Flex provenance."""
    try:
        if not archive_path.is_file() or not archive_path.name.endswith(".tar.gz"):
            raise ValueError("archive missing or invalid filename")
        stem = archive_path.name[:-7]
        if not ARTIFACT_NAME_PATTERN.fullmatch(stem) or stem in (".", ".."):
            raise ValueError("archive name invalid")
        actual_archive_sha = _sha256(archive_path)
        sidecar = (archive_path.parent / f"{archive_path.name}.sha256").read_text(encoding="utf-8").split()
        if len(sidecar) != 2 or not SHA256_PATTERN.fullmatch(sidecar[0]) or sidecar[1] != archive_path.name:
            raise ValueError("SHA256 sidecar malformed or wrong archive name")
        if sidecar[0] != actual_archive_sha:
            raise ValueError("archive/sidecar SHA256 mismatch")
        report = json.loads((archive_path.parent / f"{stem}-report.json").read_text(encoding="utf-8"))
        if type(report) is not dict or type(report.get("schema")) is not int or report["schema"] != 1:
            raise ValueError("report schema invalid")
        for key in ("sha256", "artifact", "commit", "build_id", "dev_tranche", "workstream", "version"):
            if type(report.get(key)) is not str or not report[key].strip():
                raise ValueError(f"report field missing or invalid: {key}")
        if report["sha256"] != actual_archive_sha or report["artifact"] != archive_path.name:
            raise ValueError("archive/report SHA256 or name mismatch")
        if not COMMIT_PATTERN.fullmatch(report["commit"]):
            raise ValueError("report source commit invalid")

        with tarfile.open(archive_path, "r:gz") as tar:
            files = _archive_entries(tar, stem)
            if not files:
                raise ValueError("archive root missing or empty")
            binary_name = f"{stem}/payload/flex/bin/flex-launcher"
            metadata_name = f"{stem}/payload/flex/BUILD-METADATA.json"
            manifest_name = f"{stem}/MANIFEST.sha256"
            for name in (binary_name, metadata_name, manifest_name, f"{stem}/VERSION"):
                if name not in tar.getnames() or not tar.getmember(name).isfile():
                    raise ValueError(f"critical archive member missing: {name}")
            binary_member = tar.getmember(binary_name)
            if not binary_member.mode & 0o111:
                raise ValueError("archived Flex binary not executable")
            metadata = _read_archive_json(tar, metadata_name)
            _validate_flex_metadata(metadata)
            if files["payload/flex/bin/flex-launcher"][0] != metadata["binary_sha256"]:
                raise ValueError("archived Flex binary/metadata SHA256 mismatch")
            for report_key, metadata_key in (
                ("commit", "source_commit"), ("build_id", "artifact_build_id"),
                ("dev_tranche", "dev_tranche"), ("workstream", "workstream"),
                ("version", "product_version"),
            ):
                if report[report_key] != metadata[metadata_key]:
                    raise ValueError(f"report/Flex metadata identity mismatch: {report_key}")
            version_stream = tar.extractfile(f"{stem}/VERSION")
            upstream_stream = tar.extractfile(f"{stem}/vendor/flex-launcher/UPSTREAM_COMMIT")
            if version_stream is None or upstream_stream is None:
                raise ValueError("archived source identity missing")
            if version_stream.read().decode("utf-8").strip() != report["version"]:
                raise ValueError("archived VERSION/report mismatch")
            upstream = upstream_stream.read().decode("utf-8").strip()
            if upstream != metadata["upstream_commit"] or metadata["source_revision"] != f"upstream-{upstream}+openhtpc-{report['commit']}":
                raise ValueError("Flex source revision mismatch")
            source_hashes = {
                path.removeprefix("vendor/flex-launcher/"): entry[0]
                for path, entry in files.items() if path.startswith("vendor/flex-launcher/")
            }
            if _source_fingerprint_hashes(source_hashes) != metadata["flex_source_fingerprint"]:
                raise ValueError("Flex source fingerprint mismatch")
            with tempfile.TemporaryDirectory(prefix="openhtpc-verify-flex-") as raw:
                binary_path = pathlib.Path(raw) / "flex-launcher"
                stream = tar.extractfile(binary_member)
                if stream is None:
                    raise ValueError("archived Flex binary unreadable")
                with binary_path.open("wb") as output:
                    shutil.copyfileobj(stream, output)
                if _elf_build_id(binary_path) != metadata["elf_build_id"]:
                    raise ValueError("archived Flex ELF build ID mismatch")
            manifest_stream = tar.extractfile(manifest_name)
            if manifest_stream is None:
                raise ValueError("archived manifest unreadable")
            manifest: dict[str, str] = {}
            for line in manifest_stream.read().decode("utf-8").splitlines():
                match = re.fullmatch(r"([0-9a-f]{64})  (.+)", line)
                if match is None or match.group(2) in manifest:
                    raise ValueError("archived manifest malformed or duplicate path")
                manifest[match.group(2)] = match.group(1)
            expected_manifest = {path: entry[0] for path, entry in files.items() if path != "MANIFEST.sha256"}
            if manifest != expected_manifest:
                raise ValueError("archived manifest/content mismatch")

        committed = _committed_entries(report["commit"])
        actual_source = {path: entry for path, entry in files.items() if path not in GENERATED_ARTIFACT_FILES}
        expected_source = {path: entry for path, entry in committed.items() if path not in GENERATED_ARTIFACT_FILES}
        if actual_source.keys() != expected_source.keys():
            raise ValueError("archive source does not match reported Git commit: file set")
        for path, (sha, executable) in actual_source.items():
            committed_sha, committed_executable = expected_source[path]
            if sha != committed_sha:
                raise ValueError(f"archive source does not match reported Git commit: content of {path}")
            if executable != committed_executable:
                raise ValueError(f"archive source executable mode mismatch: {path}")
        return []
    except (OSError, ValueError, KeyError, UnicodeError, json.JSONDecodeError,
            tarfile.TarError, subprocess.CalledProcessError) as exc:
        return [str(exc)]


def cmd_verify(args: argparse.Namespace) -> int:
    archive_path = pathlib.Path(args.artifact).resolve()
    _print_header(f"OPENHTPC DEVCTL — VERIFY [{archive_path.name}]")
    errors = _verify_artifact(archive_path)
    if errors:
        for error in errors:
            print(f"FAIL: {error}")
        print("  VERIFY FAILED")
        return 1
    print("  VERIFY PASS")
    return 0


def cmd_ship(args: argparse.Namespace) -> int:
    archive_path = pathlib.Path(args.artifact).resolve()
    if not archive_path.is_absolute() or not archive_path.exists():
        archive_path = ROOT / args.artifact

    target = args.target or DEFAULT_TARGET_HOST
    dest_dir = args.dest or DEFAULT_TARGET_DIR
    dry_run = args.dry_run

    _print_header(f"OPENHTPC DEVCTL — SHIP [{archive_path.name}] → {target}:{dest_dir}")

    if dry_run:
        print("[DRY-RUN MODE — no remote mutation]")

    if not archive_path.is_file():
        print(f"ERROR: Archive not found: {archive_path}", file=sys.stderr)
        return 1

    sha_path = archive_path.parent / f"{archive_path.name}.sha256"
    stem = archive_path.name
    for suffix in (".tar.gz", ".tgz"):
        if stem.endswith(suffix):
            stem = stem[: -len(suffix)]
            break
    report_path = archive_path.parent / f"{stem}-report.json"

    # Verify locally first
    local_sha = _sha256(archive_path)
    print(f"Local SHA256 : {local_sha}")

    files_to_ship = [archive_path, sha_path, report_path]
    for f in files_to_ship:
        status = "OK" if f.is_file() else "MISSING"
        print(f"  {f.name}: {status}")

    missing = [f for f in files_to_ship if not f.is_file()]
    if missing:
        print(f"\nERROR: Missing files: {[f.name for f in missing]}", file=sys.stderr)
        return 1

    if dry_run:
        print(f"\n[DRY-RUN] Would SCP to {target}:{dest_dir}:")
        for f in files_to_ship:
            print(f"  {f.name}")
        print(f"\n[DRY-RUN] Would verify remote SHA256 of {archive_path.name}")
        print(f"[DRY-RUN] Expected: {local_sha}")
        _print_separator()
        print("  SHIP DRY-RUN COMPLETE")
        _print_separator()
        return 0

    # Create remote destination directory
    print(f"\nCreating remote directory: {target}:{dest_dir}")
    mkdir_result = _run_remote(target, ["mkdir", "-p", dest_dir])
    if mkdir_result.returncode != 0:
        print(f"ERROR: mkdir failed: {mkdir_result.stderr}", file=sys.stderr)
        return 1

    # SCP each file
    for f in files_to_ship:
        print(f"Shipping: {f.name} ...")
        scp = subprocess.run(
            _scp_args(str(f), f"{target}:{dest_dir}{f.name}"),
            stdin=sys.stdin,
            check=False,
            timeout=SSH_OP_TIMEOUT,
        )
        if scp.returncode != 0:
            print(f"ERROR: SCP failed for {f.name}", file=sys.stderr)
            return 1

    # Remote SHA256 verification (using actual destination path, not sidecar text)
    remote_archive = f"{dest_dir}{archive_path.name}"
    print(f"\nVerifying remote SHA256: {remote_archive}")
    sha_result = _run_remote(target, ["sha256sum", remote_archive])
    if sha_result.returncode != 0:
        print(f"ERROR: Remote sha256sum failed: {sha_result.stderr}", file=sys.stderr)
        return 1

    remote_sha = sha_result.stdout.strip().split()[0]
    print(f"Remote SHA256: {remote_sha}")
    print(f"Local  SHA256: {local_sha}")
    if remote_sha != local_sha:
        print("ERROR: SHA256 MISMATCH — transfer integrity failure", file=sys.stderr)
        return 1

    print("SHA256 MATCH")
    _print_separator()
    print("  SHIP COMPLETE")
    _print_separator()
    return 0


def cmd_target_prepare(args: argparse.Namespace) -> int:
    target = args.target or DEFAULT_TARGET_HOST
    dry_run = args.dry_run

    _print_header(f"OPENHTPC DEVCTL — TARGET-PREPARE [{target}]")

    if dry_run:
        print("[DRY-RUN MODE — no remote mutation]")

    timestamp = datetime.datetime.now(tz=datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    snapshot_base = f"/home/steve/dev/snapshots/openhtpc-pre-{timestamp}"

    dirs_to_snapshot = [
        "$HOME/.local/lib/openhtpc",
        "$HOME/.config/openhtpc",
        "$HOME/.local/share/openhtpc/media",
    ]

    print(f"Target         : {target}")
    print(f"Snapshot base  : {snapshot_base}")
    print(f"Dirs to snapshot:")
    for d in dirs_to_snapshot:
        print(f"  {d}")

    if dry_run:
        print(f"\n[DRY-RUN] Would create snapshot at {target}:{snapshot_base}")
        print("[DRY-RUN] Would stop OPENHTPC after successful snapshot")
        _print_separator()
        print("  TARGET-PREPARE DRY-RUN COMPLETE")
        _print_separator()
        return 0

    # Create snapshot directory
    print(f"\nCreating snapshot directory on {target} ...")
    mkdir_r = _run_remote(target, ["mkdir", "-p", snapshot_base])
    if mkdir_r.returncode != 0:
        print(f"ERROR: Cannot create snapshot directory: {mkdir_r.stderr}", file=sys.stderr)
        return 1

    # Copy each source directory into snapshot
    for src in dirs_to_snapshot:
        # Expand $HOME remotely — use a shell one-liner safely (not shell=True locally)
        check_r = _run_remote(
            target,
            ["bash", "-c", f'[ -d "{src}" ] && echo EXISTS || echo MISSING'],
        )
        if "EXISTS" in check_r.stdout:
            print(f"Snapshotting {src} ...")
            cp_r = _run_remote(
                target,
                ["bash", "-c", f'cp -a "{src}" "{snapshot_base}/" 2>&1'],
            )
            if cp_r.returncode != 0:
                print(f"ERROR: Snapshot of {src} failed: {cp_r.stdout}", file=sys.stderr)
                return 1
        else:
            print(f"Skipping {src} (not present on target)")

    print(f"\nSnapshot complete: {target}:{snapshot_base}")

    # Stop OPENHTPC cleanly
    print("Stopping OPENHTPC on target ...")
    stop_r = _run_remote(
        target,
        ["bash", "-c", "openhtpc stop 2>&1 || true; sleep 2; echo STOPPED"],
    )
    print(f"Stop result: {stop_r.stdout.strip()}")

    _print_separator()
    print("  TARGET-PREPARE COMPLETE")
    print(f"  Snapshot: {target}:{snapshot_base}")
    _print_separator()
    return 0


def cmd_target_install(args: argparse.Namespace) -> int:
    archive_path = pathlib.Path(args.artifact).resolve()
    if not archive_path.exists():
        archive_path = ROOT / args.artifact

    target = args.target or DEFAULT_TARGET_HOST
    dest_dir = args.dest or DEFAULT_TARGET_DIR
    dry_run = args.dry_run

    _print_header(f"OPENHTPC DEVCTL — TARGET-INSTALL [{archive_path.name}] on {target}")

    if dry_run:
        print("[DRY-RUN MODE — no remote mutation]")
        print(f"\n[DRY-RUN] Would verify remote SHA256 of {archive_path.name}")
        print(f"[DRY-RUN] Would extract archive in {dest_dir}")
        print("[DRY-RUN] Would run update.sh")
        _print_separator()
        print("  TARGET-INSTALL DRY-RUN COMPLETE")
        _print_separator()
        return 0

    local_sha = _sha256(archive_path)
    remote_archive = f"{dest_dir}{archive_path.name}"

    # Verify remote artifact checksum
    print("Verifying remote artifact SHA256 ...")
    sha_r = _run_remote(target, ["sha256sum", remote_archive])
    if sha_r.returncode != 0:
        print(f"ERROR: Remote artifact not found or sha256sum failed: {sha_r.stderr}", file=sys.stderr)
        return 1
    remote_sha = sha_r.stdout.strip().split()[0]
    print(f"Remote SHA256: {remote_sha}")
    print(f"Local  SHA256: {local_sha}")
    if remote_sha != local_sha:
        print("ERROR: Remote artifact SHA256 mismatch. Ship again.", file=sys.stderr)
        return 1
    print("SHA256 MATCH")

    # Extract archive name stem
    stem = archive_path.name
    for suffix in (".tar.gz", ".tgz"):
        if stem.endswith(suffix):
            stem = stem[: -len(suffix)]
            break

    # Extract to dest_dir
    print(f"\nExtracting {archive_path.name} on {target}:{dest_dir} ...")
    extract_r = _run_remote(
        target,
        ["bash", "-c", f'cd "{dest_dir}" && tar -xzf "{archive_path.name}" 2>&1'],
    )
    if extract_r.returncode != 0:
        print(f"ERROR: Extraction failed: {extract_r.stdout}", file=sys.stderr)
        return 1
    print("Extraction: OK")

    # Run update.sh
    update_sh = f"{dest_dir}{stem}/update.sh"
    print(f"\nRunning update.sh from {update_sh} ...")
    update_r = _run_remote(
        target,
        ["bash", "-c", f'cd "{dest_dir}{stem}" && ./update.sh 2>&1'],
        timeout=180,
    )
    print(update_r.stdout)
    if update_r.returncode != 0:
        print(f"ERROR: update.sh failed with exit {update_r.returncode}", file=sys.stderr)
        return 1
    print("update.sh: OK")

    # Verify expected component installed (Media Foundation DEV2: media-probe)
    expected_component = "$HOME/.local/lib/openhtpc/openhtpc-media-probe.py"
    check_r = _run_remote(
        target,
        ["bash", "-c", f'test -x "{expected_component}" && echo MODE_OK || echo MISSING'],
    )
    component_ok = "MODE_OK" in check_r.stdout
    print(f"\nMedia Probe installed: {'YES' if component_ok else 'NO — WARNING'}")

    _print_separator()
    print("  TARGET-INSTALL COMPLETE")
    _print_separator()
    return 0


def cmd_target_check(args: argparse.Namespace) -> int:
    target = args.target or DEFAULT_TARGET_HOST
    media_file = args.media_file

    _print_header(f"OPENHTPC DEVCTL — TARGET-CHECK [{target}]")
    print("(Read-only post-install checks — no scanning, no mutation)")
    print()

    checks: list[tuple[str, bool, str]] = []

    def check(name: str, result: subprocess.CompletedProcess[str], expect: str | None = None) -> bool:
        ok = result.returncode == 0
        if expect is not None:
            ok = ok and expect in result.stdout
        detail = result.stdout.strip()[:120]
        checks.append((name, ok, detail))
        return ok

    # openhtpc version
    r = _run_remote(target, ["openhtpc", "version"])
    check("openhtpc version", r)
    version_str = r.stdout.strip()
    print(f"Installed version: {version_str}")

    # Media DB status
    r = _run_remote(
        target,
        ["bash", "-c", "python3 $HOME/.local/lib/openhtpc/openhtpc-media-db.py status"],
    )
    check("media-db status", r)

    # Media DB verify
    r = _run_remote(
        target,
        ["bash", "-c", "python3 $HOME/.local/lib/openhtpc/openhtpc-media-db.py verify"],
    )
    check("media-db verify", r)

    # Media Probe presence and mode
    r = _run_remote(
        target,
        ["bash", "-c",
         "f=$HOME/.local/lib/openhtpc/openhtpc-media-probe.py; "
         'test -f "$f" && test -x "$f" && echo EXECUTABLE || echo MISSING_OR_NOT_EXECUTABLE'],
    )
    probe_ok = "EXECUTABLE" in r.stdout
    checks.append(("media-probe executable", probe_ok, r.stdout.strip()))

    # Media Ingest presence and mode
    r = _run_remote(
        target,
        ["bash", "-c",
         "f=$HOME/.local/lib/openhtpc/openhtpc-media-ingest.py; "
         'test -f "$f" && test -x "$f" && echo EXECUTABLE || echo MISSING_OR_NOT_EXECUTABLE'],
    )
    ingest_ok = "EXECUTABLE" in r.stdout
    checks.append(("media-ingest executable", ingest_ok, r.stdout.strip()))

    # Optional media probe test
    if media_file:
        print(f"\nProbing explicit file: {media_file}")
        r = _run_remote(
            target,
            ["bash", "-c", f"python3 $HOME/.local/lib/openhtpc/openhtpc-media-probe.py probe {shlex.quote(media_file)}"],
        )
        check("probe explicit file", r, '"ok": true')

    print()
    passed = sum(1 for _, ok, _ in checks if ok)
    for name, ok, detail in checks:
        status = "PASS" if ok else "FAIL"
        print(f"  {status}  {name}")
        if detail and not ok:
            print(f"       {detail}")

    print()
    _print_separator()
    print(f"  TARGET-CHECK: {passed}/{len(checks)} PASS")
    _print_separator()
    return 0 if passed == len(checks) else 1


