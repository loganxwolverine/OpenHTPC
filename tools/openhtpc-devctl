def cmd_status(args: argparse.Namespace) -> int:
    _print_header("OPENHTPC DEVCTL — STATUS")

    # Git state
    head_result = _git("rev-parse", "HEAD", check=False)
    short_result = _git("rev-parse", "--short", "HEAD", check=False)
    branch_result = _git("rev-parse", "--abbrev-ref", "HEAD", check=False)
    status_result = _git("status", "--porcelain", check=False)

    head = head_result.stdout.strip() if head_result.returncode == 0 else "UNKNOWN"
    short = short_result.stdout.strip() if short_result.returncode == 0 else "UNKNOWN"
    branch = branch_result.stdout.strip() if branch_result.returncode == 0 else "UNKNOWN"
    porcelain = status_result.stdout.strip() if status_result.returncode == 0 else ""
    dirty = bool(porcelain)
    version = _product_version()

    stash_found, stash_ref = _check_protected_stash()

    print(f"Repository : {ROOT}")
    print(f"Branch     : {branch}")
    print(f"HEAD       : {head}")
    print(f"Short HEAD : {short}")
    print(f"State      : {'DIRTY' if dirty else 'CLEAN'}")
    print(f"Version    : {version}")
    print(f"Protected stash : {'PRESENT (' + stash_ref + ')' if stash_found else 'MISSING — WARNING'}")

    if dirty and porcelain:
        print("\nWorking tree changes:")
        for line in porcelain.splitlines():
            print(f"  {line}")

    # Recent Media Foundation commits
    log_result = _git(
        "log", "--oneline", "-10",
        "--", "payload/openhtpc-media-db.py", "payload/openhtpc-media-probe.py",
        check=False,
    )
    if log_result.returncode == 0 and log_result.stdout.strip():
        print("\nRecent Media Foundation commits:")
        for line in log_result.stdout.strip().splitlines():
            print(f"  {line}")

    _print_separator()
    return 0


