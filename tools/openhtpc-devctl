# ─── Helpers ────────────────────────────────────────────────────────────────

def _sha256(path: pathlib.Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _git(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=check,
        stdin=subprocess.DEVNULL,
    )


def _product_version() -> str:
    try:
        return (ROOT / "VERSION").read_text(encoding="utf-8").strip()
    except OSError:
        return "UNKNOWN"


def _check_protected_stash() -> tuple[bool, str]:
    """Return (found, stash_ref_or_message)."""
    result = _git("stash", "list", check=False)
    if result.returncode != 0:
        return False, "git stash list failed"
    for line in result.stdout.splitlines():
        if PROTECTED_STASH_DESCRIPTION in line:
            ref = line.split(":")[0].strip()
            return True, ref
    return False, "NOT FOUND"


def _repo_files() -> list[pathlib.Path]:
    """Return sorted list of all files in the working tree, excluding EXCLUDED_FROM_ARCHIVE."""
    return sorted(
        (
            p for p in ROOT.rglob("*")
            if p.is_file() and not EXCLUDED_FROM_ARCHIVE.intersection(p.relative_to(ROOT).parts)
        ),
        key=lambda p: p.relative_to(ROOT).as_posix(),
    )


def _print_separator(width: int = 60) -> None:
    print("─" * width)


def _print_header(title: str) -> None:
    _print_separator()
    print(f"  {title}")
    _print_separator()


def _ssh_args(host: str, extra: list[str] | None = None) -> list[str]:
    """Build safe SSH argument list (no shell=True, bounded timeout)."""
    base = [
        "ssh",
        "-o", f"ConnectTimeout={SSH_CONNECT_TIMEOUT}",
        "-o", "BatchMode=no",
        "-o", "StrictHostKeyChecking=accept-new",
        host,
    ]
    return base + (extra or [])


def _scp_args(src: str, dst: str) -> list[str]:
    return [
        "scp",
        "-o", f"ConnectTimeout={SSH_CONNECT_TIMEOUT}",
        "-o", "StrictHostKeyChecking=accept-new",
        src, dst,
    ]


def _run_remote(host: str, cmd: list[str], timeout: int = SSH_OP_TIMEOUT) -> subprocess.CompletedProcess[str]:
    """Run a single remote command via SSH. No shell=True. No password injection."""
    args = _ssh_args(host) + [shlex.join(cmd)]
    return subprocess.run(
        args,
        text=True,
        capture_output=True,
        stdin=subprocess.DEVNULL,
        timeout=timeout,
        check=False,
    )


def _build_archive_from_commit(commit: str, name: str, dest_dir: pathlib.Path) -> pathlib.Path:
    """Build a reproducible tar.gz from an exact git commit using git archive.

    Uses ``git archive --format=tar.gz`` which is fully deterministic given the
    same commit hash and git installation.  This is the canonical approach used
    for OPENHTPC RC8 Media Foundation development artifacts (verified against
    the official DEV2 SHA256).

    Only committed files are included — no working-tree pollution.
    """
    dest_dir.mkdir(parents=True, exist_ok=True)
    archive = dest_dir / f"{name}.tar.gz"

    with tempfile.NamedTemporaryFile(dir=dest_dir, prefix=f"{name}.", delete=False) as tmp:
        tmp_path = pathlib.Path(tmp.name)

    try:
        git_result = subprocess.run(
            ["git", "archive", "--format=tar.gz", f"--prefix={name}/", commit],
            cwd=ROOT,
            stdout=tmp_path.open("wb"),
            stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL,
            check=True,
        )
        os.replace(tmp_path, archive)
    finally:
        tmp_path.unlink(missing_ok=True)

    return archive


