    """Explicit human validation gate — never auto-passes."""
    _print_header("OPENHTPC DEVCTL — HUMAN VALIDATION REQUIRED")
    print()
    print(textwrap.dedent("""\
        OPENHTPC has been installed and is ready for physical validation.

        Please start OPENHTPC manually:

