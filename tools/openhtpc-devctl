# ─── Helpers ────────────────────────────────────────────────────────────────

def _sha256(path: pathlib.Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _git(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=check,
        stdin=subprocess.DEVNULL,
    )


def _product_version() -> str:
    try:
        return (ROOT / "VERSION").read_text(encoding="utf-8").strip()
    except OSError:
        return "UNKNOWN"


def _check_protected_stash() -> tuple[bool, str]:
    """Return (found, stash_ref_or_message)."""
    result = _git("stash", "list", check=False)
    if result.returncode != 0:
        return False, "git stash list failed"
    for line in result.stdout.splitlines():
        if PROTECTED_STASH_DESCRIPTION in line:
            ref = line.split(":")[0].strip()
            return True, ref
    return False, "NOT FOUND"


def _repo_files() -> list[pathlib.Path]:
    """Return sorted list of all files in the working tree, excluding EXCLUDED_FROM_ARCHIVE."""
    return sorted(
        (
            p for p in ROOT.rglob("*")
            if p.is_file() and not EXCLUDED_FROM_ARCHIVE.intersection(p.relative_to(ROOT).parts)
        ),
        key=lambda p: p.relative_to(ROOT).as_posix(),
    )


def _print_separator(width: int = 60) -> None:
    print("─" * width)


def _print_header(title: str) -> None:
    _print_separator()
    print(f"  {title}")
    _print_separator()


def _ssh_args(host: str, extra: list[str] | None = None) -> list[str]:
    """Build safe SSH argument list (no shell=True, bounded timeout)."""
    base = [
        "ssh",
        "-o", f"ConnectTimeout={SSH_CONNECT_TIMEOUT}",
        "-o", "BatchMode=no",
        "-o", "StrictHostKeyChecking=accept-new",
        host,
    ]
    return base + (extra or [])


def _scp_args(src: str, dst: str) -> list[str]:
    return [
        "scp",
        "-o", f"ConnectTimeout={SSH_CONNECT_TIMEOUT}",
        "-o", "StrictHostKeyChecking=accept-new",
        src, dst,
    ]


def _run_remote(host: str, cmd: list[str], timeout: int = SSH_OP_TIMEOUT) -> subprocess.CompletedProcess[str]:
    """Run a single remote command via SSH. No shell=True. No password injection."""
    args = _ssh_args(host) + [shlex.join(cmd)]
    return subprocess.run(
        args,
        text=True,
        capture_output=True,
        stdin=subprocess.DEVNULL,
        timeout=timeout,
        check=False,
    )


def _safe_members(tar: tarfile.TarFile, root: str | None = None) -> dict[str, tarfile.TarInfo]:
    """Validate archive paths before any member is used or extracted."""
    members: dict[str, tarfile.TarInfo] = {}
    for member in tar:
        name = member.name.rstrip("/") if member.isdir() else member.name
        parts = name.split("/")
        if not name or name.startswith("/") or any(p in ("", ".", "..") for p in parts):
            raise ValueError(f"unsafe archive path: {member.name!r}")
        if root is not None and parts[0] != root:
            raise ValueError(f"unexpected archive root: {member.name!r}")
        if not (member.isfile() or member.isdir()):
            raise ValueError(f"unsupported archive member: {member.name!r}")
        if name in members:
            raise ValueError(f"duplicate archive member: {name!r}")
        members[name] = member
    return members


def _archive_entries(tar: tarfile.TarFile, root: str | None = None) -> dict[str, tuple[str, bool]]:
    """Return each regular file's SHA256 and Git-style executable state."""
    members = _safe_members(tar, root)
    files: dict[str, tuple[str, bool]] = {}
    for name, member in members.items():
        if not member.isfile():
            continue
        if root is not None and "/" not in name:
            raise ValueError(f"archive file outside root directory: {name}")
        relative = name.split("/", 1)[1] if root is not None else name
        stream = tar.extractfile(member)
        if stream is None:
            raise ValueError(f"unreadable archive member: {name}")
        digest = hashlib.sha256()
        for block in iter(lambda: stream.read(1 << 20), b""):
            digest.update(block)
        files[relative] = (digest.hexdigest(), bool(member.mode & 0o111))
    return files


def _git_archive(commit: str, destination: pathlib.Path) -> None:
    with destination.open("wb") as output:
        subprocess.run(
            ["git", "archive", "--format=tar", commit], cwd=ROOT,
            stdout=output, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL,
            check=True,
        )


def _export_commit(commit: str, staging: pathlib.Path, scratch: pathlib.Path) -> None:
    source_tar = scratch / "source.tar"
    _git_archive(commit, source_tar)
    with tarfile.open(source_tar, "r:") as tar:
        members = _safe_members(tar)
        for name, member in members.items():
            target = staging / name
            if member.isdir():
                target.mkdir(parents=True, exist_ok=True)
            else:
                target.parent.mkdir(parents=True, exist_ok=True)
                stream = tar.extractfile(member)
                if stream is None:
                    raise ValueError(f"unreadable source member: {name}")
                with target.open("wb") as output:
                    shutil.copyfileobj(stream, output)
                target.chmod(member.mode & 0o777)


def _source_fingerprint(source: pathlib.Path) -> str:
    if not source.is_dir():
        raise ValueError("Flex source directory missing")
    files = sorted(p for p in source.rglob("*") if p.is_file())
    if not files:
        raise ValueError("Flex source directory empty")
    hashes = {path.relative_to(source).as_posix(): _sha256(path) for path in files}
    return _source_fingerprint_hashes(hashes)


def _source_fingerprint_hashes(hashes: dict[str, str]) -> str:
    if not hashes:
        raise ValueError("Flex source fingerprint has no files")
    digest = hashlib.sha256()
    for name, sha in sorted(hashes.items()):
        relative = name.encode("utf-8")
        digest.update(len(relative).to_bytes(4, "big"))
        digest.update(relative)
        digest.update(bytes.fromhex(sha))
    return digest.hexdigest()


def _elf_build_id(path: pathlib.Path) -> str:
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    env["LANG"] = "C"
    result = subprocess.run(
        ["readelf", "-n", str(path)], text=True, capture_output=True,
        stdin=subprocess.DEVNULL, check=True, env=env,
    )
    match = re.search(r"(?m)^\s*Build ID:\s*([0-9a-fA-F]+)\s*$", result.stdout)
    if match is None or not ELF_BUILD_ID_PATTERN.fullmatch(match.group(1).lower()):
        raise ValueError("Flex ELF build ID missing or invalid")
    return match.group(1).lower()


def _build_flex(source: pathlib.Path, build_dir: pathlib.Path) -> pathlib.Path:
    subprocess.run(
        ["cmake", "-S", str(source), "-B", str(build_dir)],
        stdin=subprocess.DEVNULL, capture_output=True, text=True, check=True,
    )
    subprocess.run(
        ["cmake", "--build", str(build_dir), "--target", "flex-launcher"],
        stdin=subprocess.DEVNULL, capture_output=True, text=True, check=True,
    )
    binary = build_dir / "flex-launcher"
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise ValueError("fresh Flex build output missing or not executable")
    return binary


def _write_manifest(staging: pathlib.Path) -> None:
    files = sorted(p for p in staging.rglob("*") if p.is_file() and p.name != "MANIFEST.sha256")
    if not files:
        raise ValueError("staging tree has no files")
    lines = [f"{_sha256(p)}  {p.relative_to(staging).as_posix()}\n" for p in files]
    (staging / "MANIFEST.sha256").write_text("".join(lines), encoding="utf-8")


def _write_archive(staging: pathlib.Path, name: str, archive: pathlib.Path) -> None:
    with tarfile.open(archive, "w:gz") as tar:
        tar.add(staging, arcname=name, recursive=True)


def _committed_entries(commit: str) -> dict[str, tuple[str, bool]]:
    tree = subprocess.run(
        ["git", "ls-tree", "-r", "-z", commit], cwd=ROOT,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        stdin=subprocess.DEVNULL, check=True,
    )
    modes: dict[str, bool] = {}
    for record in tree.stdout.split(b"\0"):
        if not record:
            continue
        try:
            header, raw_path = record.split(b"\t", 1)
            mode, kind, _object_id = header.split(b" ", 2)
            path = raw_path.decode("utf-8")
        except (ValueError, UnicodeError) as exc:
            raise ValueError("malformed Git tree entry") from exc
        if kind != b"blob" or mode not in (b"100644", b"100755") or path in modes:
            raise ValueError(f"unsupported or duplicate Git tree entry: {path}")
        modes[path] = mode == b"100755"
    with tempfile.TemporaryDirectory(prefix="openhtpc-verify-source-") as raw:
        source_tar = pathlib.Path(raw) / "source.tar"
        _git_archive(commit, source_tar)
        with tarfile.open(source_tar, "r:") as tar:
            hashes = _archive_entries(tar)
    if hashes.keys() != modes.keys():
        raise ValueError("Git tree and exported source file sets differ")
    return {path: (entry[0], modes[path]) for path, entry in hashes.items()}


